<?xml version="1.0" encoding="UTF-8"?>
<?page title="Data Entry Detail"?>

<zk>

    <borderlayout width="100%"
                  height="100%"
                  style="background:#F4F7FB;">

        <north size="62px">
            <include src="/header.zul"/>
        </north>

        <west size="280px">
            <include src="/makersidebar.zul"/>
        </west>

        <center>

            <vlayout spacing="15px"
                     style="padding:28px;">

                <!-- BATCH HEADER -->

                <groupbox width="100%"
                          style="background:white;border:1px solid #DCE5F0;">

                    <hlayout width="100%"
                             style="padding:15px 20px;">

                        <label value="Batch ID : "
                               style="font-size:18px;font-weight:bold;"/>

                        <label value="B008"
                               style="font-size:22px;font-weight:bold;color:#175CD3;"/>

                        <space hflex="1"/>

                        <label value="Cheque 1 of 5"
                               style="font-size:18px;font-weight:bold;color:#175CD3;"/>

                    </hlayout>

                </groupbox>


                <!-- MAIN AREA -->

                <hlayout width="100%"
                         spacing="25px">


                    <!-- LEFT -->

                    <vlayout hflex="1"
                             spacing="12px">

                        <label value="Scanned Cheque"
                               style="font-size:20px;font-weight:bold;color:#122B49;"/>


                        <groupbox width="100%"
                                  height="450px"
                                  style="background:white;border:1px solid #DCE5F0;">

                            <vlayout width="100%"
                                     spacing="12px"
                                     style="text-align:center;">

                                <hlayout spacing="10px">

                                    <button label="Zoom In"
                                            width="110px"/>

                                    <button label="Zoom Out"
                                            width="110px"/>

                                    <button label="Rotate"
                                            width="100px"/>

                                    <button label="Back"
                                            width="100px"
                                            onClick='Executions.sendRedirect("outward-maker-data-entry.zul")'/>

                                </hlayout>


                                <image src="/images/cheque-front.jpg"
                                       width="95%"
                                       height="340px"
                                       style="object-fit:contain;"/>

                            </vlayout>

                        </groupbox>

                    </vlayout>


                    <!-- RIGHT -->

                    <vlayout width="450px"
                             spacing="15px">

                        <groupbox width="450px"
                                  height="500px"
                                  style="background:white;border:1px solid #DCE5F0;">

                            <caption label="Scanned / Extracted Data (Errors Only)"/>

                            <vlayout spacing="12px"
                                     style="padding:15px;">

                                <label value="The following fields have Data Entry errors."
                                       style="font-size:14px;color:#667085;"/>

                                <label value="Please correct and save."
                                       style="font-size:14px;color:#667085;"/>


                                <!-- ACCOUNT -->

                                <label value="Account Number *"
                                       style="font-size:15px;font-weight:bold;"/>

                                <label value="Account Number Error"
                                       style="color:#D92D20;background:#FEF3F2;padding:5px;"/>

                                <label value="Scanned Value"
                                       style="color:#667085;"/>

                                <textbox value="123456789011"
                                         width="100%"
                                         readonly="true"
                                         style="background:#F2F4F7;"/>

                                <label value="Correct Value *"
                                       style="font-weight:bold;"/>

                                <textbox value="123456789010"
                                         width="100%"/>


                                <!-- DATE -->

                                <label value="Cheque Date *"
                                       style="font-size:15px;font-weight:bold;"/>

                                <label value="Date Error"
                                       style="color:#D92D20;background:#FEF3F2;padding:5px;"/>

                                <label value="Scanned Value"
                                       style="color:#667085;"/>

                                <textbox value="16-06-2025"
                                         width="100%"
                                         readonly="true"/>

                                <label value="Correct Value *"
                                       style="font-weight:bold;"/>

                                <datebox width="100%"/>


                                <!-- AMOUNT -->

                                <label value="Amount *"
                                       style="font-size:15px;font-weight:bold;"/>

                                <label value="Amount Error"
                                       style="color:#D92D20;background:#FEF3F2;padding:5px;"/>

                                <label value="Scanned Value"
                                       style="color:#667085;"/>

                                <textbox value="50649.01"
                                         width="100%"
                                         readonly="true"/>

                                <label value="Correct Value *"
                                       style="font-weight:bold;"/>

                                <decimalbox width="100%"
                                            placeholder="Enter correct amount"/>

                            </vlayout>

                        </groupbox>

                    </vlayout>

                </hlayout>


                <!-- BUTTONS -->

                <hlayout width="100%"
                         valign="middle"
                         style="padding-top:10px;">

                    <button label="Back to List"
                            width="140px"
                            onClick='Executions.sendRedirect("outward-maker-data-entry.zul")'/>

                    <button label="Prev"
                            width="100px"
                            disabled="true"/>

                    <button label="Next"
                            width="100px"/>

                    <space hflex="1"/>

                    <button label="Reject"
                            width="120px"
                            style="background:white;color:#D92D20;border:1px solid #D92D20;"/>

                    <button label="Save &amp; Next"
                            width="155px"
                            style="background:#2457D6;color:white;border:none;"/>

                </hlayout>

            </vlayout>

        </center>

    </borderlayout>

</zk>