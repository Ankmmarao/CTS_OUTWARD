<?xml version="1.0" encoding="UTF-8"?>

<?page title="Outward Maker Dashboard"?>

<zk>

    <!-- ========================================================= -->
    <!-- OUTWARD MAKER DASHBOARD WINDOW                            -->
    <!-- ========================================================= -->

    <window
        id="outwardMakerDashboardWindow"
        width="100%"
        height="100%"
        border="none"
        apply="com.iispl.cts.controller.outward.OutwardMakerDashboardController">

        <borderlayout
            width="100%"
            height="100%"
            style="background:#F4F7FB;">

            <!-- ================================================= -->
            <!-- HEADER                                            -->
            <!-- ================================================= -->

            <north size="62px">
                <include src="/header.zul"/>
            </north>

            <!-- ================================================= -->
            <!-- SIDEBAR                                           -->
            <!-- ================================================= -->

            <west size="280px">
                <include src="/makersidebar.zul"/>
            </west>

            <!-- ================================================= -->
            <!-- CENTER                                            -->
            <!-- ================================================= -->

            <center>

                <vlayout
                    spacing="22px"
                    width="100%"
                    height="100%"
                    style="
                        padding:32px;
                        overflow:auto;
                    ">

                    <!-- ================================================= -->
                    <!-- PAGE TITLE                                       -->
                    <!-- ================================================= -->

                    <label
                        value="Outward Maker Dashboard"
                        style="
                            font-size:30px;
                            font-weight:bold;
                            color:#122B49;
                        "/>

                    <!-- ================================================= -->
                    <!-- SUMMARY CARDS                                    -->
                    <!-- ================================================= -->

                    <hlayout
                        spacing="20px"
                        width="100%">

                        <!-- ============================================= -->
                        <!-- PENDING DATA ENTRY                            -->
                        <!-- ============================================= -->

                        <groupbox
                            width="300px"
                            height="130px"
                            style="
                                background:white;
                                border:1px solid #DCE5F0;
                                border-radius:8px;
                            ">

                            <vlayout
                                spacing="10px"
                                width="100%"
                                height="100%"
                                style="
                                    padding:20px;
                                    text-align:center;
                                ">

                                <label
                                    value="Pending Data Entry"
                                    style="
                                        font-size:17px;
                                        color:#51657D;
                                    "/>

                                <label
                                    value="8"
                                    style="
                                        font-size:34px;
                                        font-weight:bold;
                                        color:#F39A00;
                                    "/>

                            </vlayout>

                        </groupbox>

                        <!-- ============================================= -->
                        <!-- MICR REPAIR                                   -->
                        <!-- ============================================= -->

                        <groupbox
                            width="300px"
                            height="130px"
                            style="
                                background:white;
                                border:1px solid #DCE5F0;
                                border-radius:8px;
                            ">

                            <vlayout
                                spacing="10px"
                                width="100%"
                                height="100%"
                                style="
                                    padding:20px;
                                    text-align:center;
                                ">

                                <label
                                    value="MICR Repair"
                                    style="
                                        font-size:17px;
                                        color:#51657D;
                                    "/>

                                <label
                                    value="4"
                                    style="
                                        font-size:34px;
                                        font-weight:bold;
                                        color:#E74C3C;
                                    "/>

                            </vlayout>

                        </groupbox>

                        <!-- ============================================= -->
                        <!-- READY TO SUBMIT                               -->
                        <!-- ============================================= -->

                        <groupbox
                            width="300px"
                            height="130px"
                            style="
                                background:white;
                                border:1px solid #DCE5F0;
                                border-radius:8px;
                            ">

                            <vlayout
                                spacing="10px"
                                width="100%"
                                height="100%"
                                style="
                                    padding:20px;
                                    text-align:center;
                                ">

                                <label
                                    value="Ready to Submit"
                                    style="
                                        font-size:17px;
                                        color:#51657D;
                                    "/>

                                <label
                                    value="6"
                                    style="
                                        font-size:34px;
                                        font-weight:bold;
                                        color:#12B76A;
                                    "/>

                            </vlayout>

                        </groupbox>

                    </hlayout>


                    <!-- ================================================= -->
                    <!-- BATCHES GROUPBOX                                -->
                    <!-- ================================================= -->

                    <groupbox
                        width="100%"
                        height="450px"
                        style="
                            background:white;
                            border:1px solid #DCE5F0;
                            border-radius:8px;
                        ">

                        <caption
                            label="Batches"
                            style="
                                font-size:18px;
                                font-weight:bold;
                                color:#122B49;
                            "/>


                        <!-- ================================================= -->
                        <!-- BATCH LISTBOX                                    -->
                        <!-- ================================================= -->

                        <listbox
                            id="batchListbox"
                            width="100%"
                            height="390px"
                            emptyMessage="No batches available."
                            nonselectableTags="button"
                            style="
                                font-size:14px;
                                border:none;
                            ">

                            <!-- ============================================= -->
                            <!-- TABLE HEADER                                  -->
                            <!-- ============================================= -->

                            <listhead>

                                <!-- COLUMN 1 -->
                                <listheader
                                    label="Batch No"
                                    width="16%"/>

                                <!-- COLUMN 2 -->
                                <listheader
                                    label="Total Cheques"
                                    width="18%"/>

                                <!-- COLUMN 3 -->
                                <listheader
                                    label="Status"
                                    width="28%"/>

                                <!-- COLUMN 4 -->
                                <listheader
                                    label="Action"
                                    width="18%"/>

                                <!-- COLUMN 5 -->
                                <listheader
                                    label="Assignment"
                                    width="20%"/>

                            </listhead>


                            <!-- ================================================= -->
                            <!-- EXAMPLE AVAILABLE BATCH                           -->
                            <!-- ================================================= -->

                            <listitem value="BATCH001">

                                <!-- Batch Number -->
                                <listcell
                                    label="BATCH001"/>

                                <!-- Total Cheques -->
                                <listcell
                                    label="25"/>

                                <!-- Status -->
                                <listcell
                                    label="Captured"/>

                                <!-- Action -->
                                <listcell>

                                    <button
                                        label="Open"
                                        width="85px"
                                        height="32px"
                                        style="
                                            background:#12B76A;
                                            color:white;
                                            border:none;
                                            border-radius:5px;
                                            font-weight:bold;
                                        "
                                        onClick="openBatch(self.parent.parent.value)"/>

                                </listcell>

                                <!-- Assignment -->
                                <listcell
                                    label="Available"/>

                            </listitem>


                            <!-- ================================================= -->
                            <!-- EXAMPLE LOCKED BATCH                              -->
                            <!-- ================================================= -->

                            <listitem value="BATCH002">

                                <!-- Batch Number -->
                                <listcell
                                    label="BATCH002"/>

                                <!-- Total Cheques -->
                                <listcell
                                    label="30"/>

                                <!-- Status -->
                                <listcell
                                    label="Captured"/>

                                <!-- Action -->
                                <listcell>

                                    <label
                                        value="🔒 Locked"
                                        style="
                                            color:#E74C3C;
                                            font-weight:bold;
                                        "/>

                                </listcell>

                                <!-- Assignment -->
                                <listcell
                                    label="Assigned"/>

                            </listitem>


                            <!-- ================================================= -->
                            <!-- EXAMPLE AVAILABLE BATCH                           -->
                            <!-- ================================================= -->

                            <listitem value="BATCH003">

                                <!-- Batch Number -->
                                <listcell
                                    label="BATCH003"/>

                                <!-- Total Cheques -->
                                <listcell
                                    label="18"/>

                                <!-- Status -->
                                <listcell
                                    label="Ready"/>

                                <!-- Action -->
                                <listcell>

                                    <button
                                        label="Open"
                                        width="85px"
                                        height="32px"
                                        style="
                                            background:#12B76A;
                                            color:white;
                                            border:none;
                                            border-radius:5px;
                                            font-weight:bold;
                                        "
                                        onClick="openBatch(self.parent.parent.value)"/>

                                </listcell>

                                <!-- Assignment -->
                                <listcell
                                    label="Available"/>

                            </listitem>


                        </listbox>

                    </groupbox>

                </vlayout>

            </center>

        </borderlayout>

    </window>

</zk>

