<?page title="Capture Operator Sidebar" contentType="text/html;charset=UTF-8"?>

<zk>

    <vlayout width="100%"
             height="100%"
             style="
                background:#071b33;
                padding:25px 15px;
             ">

        <!-- BATCH CAPTURE -->
        <a href="/capture-operator-batch-capture.zul"
           width="100%"
           style="
                display:block;
                text-decoration:none;
                margin-bottom:10px;
           ">

            <div width="100%"
                 height="55px"
                 style="
                    background:#078fe5;
                    border-radius:5px;
                    padding:0 20px;
                    display:flex;
                    align-items:center;
                 ">

                <label value="▣"
                       style="
                            color:white;
                            font-size:20px;
                            margin-right:15px;
                       "/>

                <label value="Batch Capture"
                       style="
                            color:white;
                            font-size:17px;
                            font-weight:bold;
                       "/>

            </div>

        </a>


        <!-- CAPTURED BATCHES -->
        <a href="/capture-operator-captured-batches.zul"
           width="100%"
           style="
                display:block;
                text-decoration:none;
                margin-bottom:10px;
           ">

            <div width="100%"
                 height="55px"
                 style="
                    background:#071b33;
                    border-radius:5px;
                    padding:0 20px;
                    display:flex;
                    align-items:center;
                 ">

                <label value="☷"
                       style="
                            color:white;
                            font-size:21px;
                            margin-right:15px;
                       "/>

                <label value="Captured Batches"
                       style="
                            color:white;
                            font-size:17px;
                            font-weight:bold;
                       "/>

            </div>

        </a>

    </vlayout>

</zk>