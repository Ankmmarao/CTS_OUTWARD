<?xml version="1.0" encoding="UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml">

    <borderlayout
        width="100%"
        height="100%"
        apply="com.iispl.cts.controller.outward.checker.CheckerDashboardController">

        <!-- ================= HEADER ================= -->
        <north size="70px" border="none">
            <include src="/header.zul"/>
        </north>


        <!-- ================= SIDEBAR ================= -->
        <west size="230px" border="none" splittable="false">
            <include src="/checkersidebar.zul"/>
        </west>


        <!-- ================= MAIN CONTENT ================= -->
        <center border="none">

            <div width="100%"
                 height="100%"
                 style="padding:25px;">

                <!-- PAGE TITLE -->
                <div style="margin-bottom:20px;">

                    <label value="Checker Dashboard"
                           style="font-size:26px;
                                  font-weight:bold;
                                  color:#172B4D;"/>

                    <separator height="5px"/>

                    <label value="Monitor and verify outward batches"
                           style="font-size:14px;
                                  color:#6B7280;"/>

                </div>


                <!-- ================= SUMMARY CARDS ================= -->

                <hlayout width="100%"
                         spacing="15px"
                         style="margin-bottom:25px;">

                    <!-- Pending Verification -->
                    <div width="30%"
                         style="background:#FFFFFF;
                                border:1px solid #E5E7EB;
                                border-radius:8px;
                                padding:20px;">

                        <label value="Pending Verification"
                               style="font-size:14px;
                                      color:#6B7280;"/>

                        <separator height="8px"/>

                        <label id="pendingVerificationCount"
                               value="0"
                               style="font-size:28px;
                                      font-weight:bold;
                                      color:#172B4D;"/>

                    </div>


                    <!-- CBS Validation -->
                    <div width="30%"
                         style="background:#FFFFFF;
                                border:1px solid #E5E7EB;
                                border-radius:8px;
                                padding:20px;">

                        <label value="CBS Validation"
                               style="font-size:14px;
                                      color:#6B7280;"/>

                        <separator height="8px"/>

                        <label id="cbsValidationCount"
                               value="0"
                               style="font-size:28px;
                                      font-weight:bold;
                                      color:#172B4D;"/>

                    </div>


                    <!-- Ready To Send -->
                    <div width="30%"
                         style="background:#FFFFFF;
                                border:1px solid #E5E7EB;
                                border-radius:8px;
                                padding:20px;">

                        <label value="Ready To Send"
                               style="font-size:14px;
                                      color:#6B7280;"/>

                        <separator height="8px"/>

                        <label id="readyToSendCount"
                               value="0"
                               style="font-size:28px;
                                      font-weight:bold;
                                      color:#172B4D;"/>

                    </div>

                </hlayout>


                <!-- ================= BATCH TABLE ================= -->

                <div width="100%"
                     style="background:#FFFFFF;
                            border:1px solid #E5E7EB;
                            border-radius:8px;
                            padding:20px;">

                    <label value="Checker Batch Queue"
                           style="font-size:18px;
                                  font-weight:bold;
                                  color:#172B4D;"/>

                    <separator height="15px"/>


                    <listbox id="batchListbox"
                             width="100%"
                             mold="paging"
                             pageSize="10"
                             emptyMessage="No batches available for verification.">

                        <listhead>

                            <listheader label="Batch Number"
                                        width="20%"/>

                            <listheader label="Total Cheques"
                                        width="15%"/>

                            <listheader label="Status"
                                        width="20%"/>

                            <listheader label="Assignment"
                                        width="20%"/>

                            <listheader label="Action"
                                        width="15%"/>

                        </listhead>

                    </listbox>

                </div>

            </div>

        </center>

    </borderlayout>

</zk>