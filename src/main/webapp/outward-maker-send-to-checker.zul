<?xml version="1.0" encoding="UTF-8"?>

<?page title="Send to Checker"?>

<zk>

    <borderlayout width="100%"
                  height="100%"
                  style="background:#F4F7FB;">

        <!-- HEADER -->
        <north size="62px">
            <include src="/header.zul"/>
        </north>

        <!-- MAKER SIDEBAR -->
        <west size="280px">
            <include src="/makersidebar.zul"/>
        </west>

        <!-- MAIN CONTENT -->
        <center>

            <vlayout spacing="20px"
                     style="padding:30px;">

                <!-- PAGE TITLE -->
                <label value="Send to Checker"
                       style="font-size:30px;
                              font-weight:bold;
                              color:#122B49;"/>

                <!-- INFORMATION -->
                <groupbox width="100%"
                          style="background:white;
                                 border:1px solid #DCE5F0;">

                    <vlayout>

                        <hlayout style="background:#EEF6FF;
                                        padding:15px;">

                            <label value="ⓘ The following outward batches have completed maker processing and are ready to be submitted to Outward Checker."
                                   style="font-size:15px;
                                          color:#174EA6;"/>

                        </hlayout>


                        <!-- BATCH LIST -->
                        <listbox id="batchListbox"
                                 width="100%"
                                 emptyMessage="No batches are ready to submit."
                                 mold="paging"
                                 pageSize="10">

                            <listhead>

                                <listheader label="Batch ID"
                                            width="20%"/>

                                <listheader label="Total Cheques"
                                            width="20%"/>

                                <listheader label="Status"
                                            width="30%"/>

                                <listheader label="Action"
                                            width="25%"/>

                            </listhead>

                        </listbox>

                    </vlayout>

                </groupbox>

            </vlayout>

        </center>

    </borderlayout>

</zk>