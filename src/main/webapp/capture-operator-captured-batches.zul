<?page title="Captured Batches" contentType="text/html;charset=UTF-8"?>

<zk>

    <window id="capturedBatchesWindow"
            border="none"
            width="100%"
            height="100%"
            apply="com.iispl.cts.controller.outward.CaptureOperatorCapturedBatchesController"
            style="background:#ffffff;">

        <!-- =====================================================
             EXISTING HEADER
             ===================================================== -->

        <include src="/header.zul"/>


        <hlayout width="100%"
                 height="calc(100% - 70px)"
                 style="background:#ffffff;">

            <!-- =================================================
                 CAPTURE OPERATOR SIDEBAR
                 ================================================= -->

            <div width="305px"
                 height="100%"
                 style="
                    background:#071b33;
                    flex-shrink:0;
                 ">

                <include src="/captureoperatorsidebar.zul"/>

            </div>


            <!-- =================================================
                 MAIN CONTENT
                 ================================================= -->

            <div width="calc(100% - 305px)"
                 height="100%"
                 style="
                    background:#ffffff;
                    padding:35px 55px;
                    overflow:auto;
                 ">

                <!-- PAGE TITLE -->

                <label value="Captured Batches"
                       style="
                            display:block;
                            color:#12375b;
                            font-size:32px;
                            font-weight:bold;
                            margin-bottom:30px;
                       "/>


                <!-- =================================================
                     CAPTURED BATCH TABLE
                     ================================================= -->

                <groupbox width="100%"
                          style="
                            border:1px solid #d4dce5;
                            background:#ffffff;
                          ">

                    <caption label="Batches"
                             style="
                                color:#12375b;
                                font-size:21px;
                                font-weight:bold;
                             "/>


                    <div style="padding:18px;">

                        <listbox id="capturedBatchesList"
                                 width="100%"
                                 mold="paging"
                                 pageSize="10"
                                 emptyMessage="No captured batches available."
                                 style="
                                    border:1px solid #d7dfe8;
                                    font-size:16px;
                                 ">

                            <!-- =====================================
                                 TABLE HEADER
                                 ===================================== -->

                            <listhead sizable="true"
                                      height="52px"
                                      style="
                                        background:#078fe5;
                                        color:white;
                                      ">

                                <listheader label="Batch No"
                                            width="35%"
                                            style="
                                                background:#078fe5;
                                                color:white;
                                                font-size:16px;
                                                font-weight:bold;
                                            "/>

                                <listheader label="Total Cheques"
                                            width="25%"
                                            style="
                                                background:#078fe5;
                                                color:white;
                                                font-size:16px;
                                                font-weight:bold;
                                            "/>

                                <listheader label="Status"
                                            width="25%"
                                            style="
                                                background:#078fe5;
                                                color:white;
                                                font-size:16px;
                                                font-weight:bold;
                                            "/>

                            </listhead>

                            <!--
                                Rows are loaded dynamically by
                                CaptureOperatorCapturedBatchesController.
                            -->

                        </listbox>

                    </div>

                </groupbox>

            </div>

        </hlayout>

    </window>

</zk>