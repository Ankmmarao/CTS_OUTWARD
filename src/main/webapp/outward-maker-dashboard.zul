<?xml version="1.0" encoding="UTF-8"?>

<?page title="Outward Maker Dashboard"?>

<zk>

    <style><![CDATA[

        /* 1. Remove browser margin and prevent full page scrolling */

        html, body {
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            height: 100% !important;
            overflow: hidden !important;
            background: #F4F7FB;
        }


        /* 2. Strip default ZK Window and Borderlayout margins/paddings */

        .z-window-embedded,
        .z-window-embedded-cnt,
        .z-window-content {
            padding: 0 !important;
            margin: 0 !important;
            border: none !important;
            width: 100% !important;
            height: 100% !important;
        }


        .z-borderlayout {
            background: transparent !important;
            border: none !important;
        }


        .z-north,
        .z-west,
        .z-center,
        .z-south,
        .z-east {
            border: none !important;
            padding: 0 !important;
            margin: 0 !important;
        }


        .z-north-body,
        .z-west-body,
        .z-center-body {
            padding: 0 !important;
            margin: 0 !important;
            height: 100% !important;
        }


        /* 3. Keep sidebar dark background seamless */

        .z-west {
            background: #081B33 !important;
        }


        /* 4. Scrollable listbox body only */

        .batch-grid .z-listbox-body {
            overflow-y: auto !important;
        }

    ]]></style>


    <window
        id="outwardMakerDashboardWindow"
        width="100%"
        height="100%"
        border="none"
        apply="com.iispl.cts.controller.outward.OutwardMakerDashboardController">

        <borderlayout width="100%" height="100%">

            <!-- ================================================= -->
            <!-- HEADER                                            -->
            <!-- ================================================= -->

            <north
                size="62px"
                border="none"
                margins="0,0,0,0">

                <include
                    src="/header.zul"
                    style="display:block; width:100%; height:62px;"/>

            </north>


            <!-- ================================================= -->
            <!-- SIDEBAR                                           -->
            <!-- ================================================= -->

            <west
                size="280px"
                border="none"
                margins="0,0,0,0">

                <include
                    src="/makersidebar.zul"
                    style="display:block; width:280px; height:100%;"/>

            </west>


            <!-- ================================================= -->
            <!-- CENTER                                             -->
            <!-- ================================================= -->

            <center
                border="none"
                margins="0,0,0,0"
                style="background:#F4F7FB; overflow:hidden;">

                <vlayout
                    spacing="16px"
                    width="100%"
                    height="100%"
                    style="
                        padding: 24px 30px;
                        box-sizing: border-box;
                        overflow: hidden;
                    ">


                    <!-- ================================================= -->
                    <!-- PAGE TITLE                                        -->
                    <!-- ================================================= -->

                    <label
                        value="Outward Maker Dashboard"
                        style="
                            font-size: 26px;
                            font-weight: bold;
                            color: #122B49;
                            display: block;
                        "/>


                    <!-- ================================================= -->
                    <!-- BATCHES SECTION                                    -->
                    <!-- ================================================= -->

                    <div
                        vflex="1"
                        width="100%"
                        style="
                            background: white;
                            border: 1px solid #DCE5F0;
                            border-radius: 8px;
                            padding: 16px 20px;
                            box-sizing: border-box;
                            display: flex;
                            flex-direction: column;
                            min-height: 0;
                        ">


                        <label
                            value="Batches"
                            style="
                                font-size: 17px;
                                font-weight: bold;
                                color: #122B49;
                                margin-bottom: 12px;
                                display: block;
                            "/>


                        <!-- ================================================= -->
                        <!-- BATCH LIST                                        -->
                        <!-- ================================================= -->

                        <listbox
                            id="batchListbox"
                            vflex="1"
                            width="100%"
                            sclass="batch-grid"
                            emptyMessage="No batches available."
                            nonselectableTags="button"
                            style="border: none;">

                            <listhead>

                                <listheader
                                    label="Batch No"
                                    width="26%"/>

                                <listheader
                                    label="Total Cheques"
                                    width="16%"/>

                                <listheader
                                    label="Status"
                                    width="22%"/>

                                <listheader
                                    label="Action"
                                    width="18%"/>

                                <listheader
                                    label="Assignment"
                                    width="18%"/>

                            </listhead>


                            <!-- ================================================= -->
                            <!-- BATCH 001                                        -->
                            <!-- ================================================= -->

                            <listitem value="BATCH001">

                                <listcell
                                    label="OUT20260907101611469"/>

                                <listcell
                                    label="5"/>

                                <listcell
                                    label="ASSIGNED"/>

                                <listcell>

                                    <label
                                        value="🔒 Locked"
                                        style="
                                            color:#E74C3C;
                                            font-weight:bold;
                                        "/>

                                </listcell>

                                <listcell
                                    label="Maker 108"/>

                            </listitem>


                            <!-- ================================================= -->
                            <!-- BATCH 002                                        -->
                            <!-- ================================================= -->

                            <listitem value="BATCH002">

                                <listcell
                                    label="OUT20260907101753482"/>

                                <listcell
                                    label="5"/>

                                <listcell
                                    label="ASSIGNED"/>

                                <listcell>

                                    <label
                                        value="🔒 Locked"
                                        style="
                                            color:#E74C3C;
                                            font-weight:bold;
                                        "/>

                                </listcell>

                                <listcell
                                    label="Maker 103"/>

                            </listitem>


                            <!-- ================================================= -->
                            <!-- BATCH 003                                        -->
                            <!-- ================================================= -->

                            <listitem value="BATCH003">

                                <listcell
                                    label="OUT20260907101855550"/>

                                <listcell
                                    label="5"/>

                                <listcell
                                    label="CAPTURED"/>

                                <listcell>

                                    <button
                                        label="Open"
                                        width="80px"
                                        height="30px"
                                        style="
                                            background:#12B76A;
                                            color:white;
                                            border:none;
                                            border-radius:5px;
                                            font-weight:bold;
                                            cursor:pointer;
                                        "
                                        onClick="openBatch(self.parent.parent.value)"/>

                                </listcell>

                                <listcell
                                    label="Available"/>

                            </listitem>


                        </listbox>

                    </div>

                </vlayout>

            </center>

        </borderlayout>

    </window>

</zk>