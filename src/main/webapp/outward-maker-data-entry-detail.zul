<?xml version="1.0" encoding="UTF-8"?>

<?page title="Data Entry Detail"?>

<zk>

    <window
        width="100%"
        height="100vh"
        border="none"
        apply="com.iispl.cts.controller.outward.OutwardMakerDataEntryDetailController">

        <borderlayout
            width="100%"
            height="100%"
            style="background:#F4F7FB;">

            <!-- ================= HEADER ================= -->

            <north size="62px">
                <include src="/header.zul"/>
            </north>


            <!-- ================= SIDEBAR ================= -->

            <west size="280px">
                <include src="/makersidebar.zul"/>
            </west>


            <!-- ================= CENTER ================= -->

            <center style="overflow:auto;">

                <vlayout
                    spacing="15px"
                    style="padding:20px; padding-bottom:30px;">


                    <!-- ================= BATCH HEADER ================= -->

                    <groupbox
                        width="100%"
                        style="background:white;border:1px solid #DCE5F0;">

                        <hlayout
                            width="100%"
                            style="padding:15px 20px;">

                            <label
                                value="Batch ID : "
                                style="font-size:18px;font-weight:bold;"/>

                            <label
                                id="batchIdLabel"
                                value=""
                                style="font-size:22px;font-weight:bold;color:#175CD3;"/>

                            <space hflex="1"/>

                            <label
                                id="chequeProgressLabel"
                                value=""
                                style="font-size:18px;font-weight:bold;color:#175CD3;"/>

                        </hlayout>

                    </groupbox>


                    <!-- ================= MAIN AREA ================= -->

                    <hlayout
                        width="100%"
                        spacing="20px"
                        valign="top">


                        <!-- ================= LEFT IMAGE AREA ================= -->

                        <vlayout
                            hflex="1"
                            spacing="10px">

                            <label
                                value="Scanned Cheque"
                                style="font-size:18px;font-weight:bold;color:#122B49;"/>


                            <groupbox
                                width="100%"
                                height="400px"
                                style="background:white;border:1px solid #DCE5F0;">

                                <vlayout
                                    width="100%"
                                    spacing="10px"
                                    style="padding:10px;text-align:center;">


                                    <!-- IMAGE CONTROL BUTTONS -->

                                    <hlayout
                                        spacing="8px"
                                       >

                                        <!-- FRONT IMAGE -->

                                        <button
                                            id="frontImageButton"
                                            label="Front Image"
                                            width="105px"/>


                                        <!-- BACK IMAGE -->

                                        <button
                                            id="backImageButton"
                                            label="Back Image"
                                            width="105px"/>


                                        <!-- ZOOM IN -->

                                        <button
                                            id="zoomInButton"
                                            label="Zoom In"
                                            width="90px"/>


                                        <!-- ZOOM OUT -->

                                        <button
                                            id="zoomOutButton"
                                            label="Zoom Out"
                                            width="90px"/>


                                        <!-- ROTATE -->

                                        <button
                                            id="rotateButton"
                                            label="Rotate"
                                            width="85px"/>


                                        <!-- BACK TO LIST -->

                                        <button
                                            label="Back"
                                            width="80px"
                                            onClick='Executions.sendRedirect("outward-maker-data-entry.zul")'/>

                                    </hlayout>


                                    <!-- ================= IMAGE AREA ================= -->

                                    <vlayout
                                        width="100%"
                                        height="300px"
                                        style="overflow:hidden;text-align:center;">


                                        <!-- FRONT IMAGE - DEFAULT -->

                                        <image
                                            id="frontImage"
                                            src="https://commons.wikimedia.org/wiki/Special:Redirect/file/Subcheck_FRONT.png"
                                            width="95%"
                                            height="280px"
                                            visible="true"
                                            style="object-fit:contain;"/>


                                        <!-- BACK IMAGE - HIDDEN BY DEFAULT -->

                                        <image
                                            id="backImage"
                                            src="https://placehold.co/900x400?text=Cheque+Back"
                                            width="95%"
                                            height="280px"
                                            visible="false"
                                            style="object-fit:contain;"/>

                                    </vlayout>

                                </vlayout>

                            </groupbox>

                        </vlayout>


                        <!-- ================= RIGHT DATA AREA ================= -->

                        <vlayout
                            width="430px"
                            spacing="10px">

                            <groupbox
                                width="430px"
                                height="500px"
                                style="background:white;border:1px solid #DCE5F0;">

                                <caption
                                    label="Scanned / Extracted Data"/>


                                <vlayout
                                    spacing="10px"
                                    style="padding:15px;">


                                    <!-- ERROR HEADER -->

                                    <label
                                        value="Data Entry Error Fields"
                                        style="font-size:14px;color:#667085;"/>


                                    <!-- ================= ACCOUNT NUMBER ================= -->

                                    <label
                                        value="Account Number *"
                                        style="font-size:14px;font-weight:bold;"/>

                                    <label
                                        value="Account Number Error"
                                        style="color:#D92D20;background:#FEF3F2;padding:4px;"/>

                                    <label
                                        value="Scanned Value"
                                        style="font-size:12px;color:#667085;"/>

                                    <textbox
                                        value="123456789011"
                                        width="100%"
                                        readonly="true"
                                        style="background:#F2F4F7;"/>

                                    <label
                                        value="Correct Value *"
                                        style="font-size:14px;font-weight:bold;"/>

                                    <textbox
                                        id="accountNumberTextbox"
                                        width="100%"/>


                                    <!-- ================= CHEQUE DATE ================= -->

                                    <label
                                        value="Cheque Date *"
                                        style="font-size:14px;font-weight:bold;margin-top:5px;"/>

                                    <label
                                        value="Date Error"
                                        style="color:#D92D20;background:#FEF3F2;padding:4px;"/>

                                    <label
                                        value="Scanned Value"
                                        style="font-size:12px;color:#667085;"/>

                                    <textbox
                                        value="16-06-2025"
                                        width="100%"
                                        readonly="true"
                                        style="background:#F2F4F7;"/>

                                    <label
                                        value="Correct Value *"
                                        style="font-size:14px;font-weight:bold;"/>

                                    <textbox
                                        id="chequeDateTextbox"
                                        width="100%"/>


                                    <!-- ================= AMOUNT ================= -->

                                    <label
                                        value="Amount *"
                                        style="font-size:14px;font-weight:bold;margin-top:5px;"/>

                                    <label
                                        value="Amount Error"
                                        style="color:#D92D20;background:#FEF3F2;padding:4px;"/>

                                    <label
                                        value="Scanned Value"
                                        style="font-size:12px;color:#667085;"/>

                                    <textbox
                                        value="50649.01"
                                        width="100%"
                                        readonly="true"
                                        style="background:#F2F4F7;"/>

                                    <label
                                        value="Correct Value *"
                                        style="font-size:14px;font-weight:bold;"/>

                                    <decimalbox
                                        id="amountTextbox"
                                        width="100%"
                                        placeholder="Enter correct amount"/>

                                </vlayout>

                            </groupbox>

                        </vlayout>

                    </hlayout>


                    <!-- ================= BOTTOM BUTTONS ================= -->

                    <hlayout
                        width="100%"
                        valign="middle"
                        style="padding-top:5px;padding-bottom:10px;">

                        <!-- BACK TO LIST -->

                        <button
                            id="backButton"
                            label="Back to List"
                            width="130px"/>


                        <!-- PREVIOUS -->

                        <button
                            id="prevButton"
                            label="Prev"
                            width="90px"
                            style="margin-left:5px;"/>


                        <!-- NEXT -->

                        <button
                            id="nextButton"
                            label="Next"
                            width="90px"
                            style="margin-left:5px;"/>


                        <space hflex="1"/>


                        <!-- REJECT -->

                        <button
                            id="rejectButton"
                            label="Reject"
                            width="110px"
                            style="background:white;color:#D92D20;border:1px solid #D92D20;"/>


                        <!-- SAVE & NEXT -->

                        <button
                            id="saveNextButton"
                            label="Save &amp; Next"
                            width="145px"
                            style="background:#2457D6;color:white;border:none;margin-left:5px;"/>

                    </hlayout>

                </vlayout>

            </center>

        </borderlayout>

    </window>

</zk>