<?page title="Captured Batches" contentType="text/html;charset=UTF-8"?>

<zk>

    <!-- PAGE CSS -->
    <style src="/css/outward-maker/captured-batches.css"/>

    <window
        id="capturedBatchesWindow"
        border="none"
        width="100%"
        height="100%"
        apply="com.iispl.cts.controller.outward.CaptureOperatorCapturedBatchesController"
        sclass="captured-batches-window">

        <!-- HEADER -->
        <include
            src="/header.zul"
            sclass="captured-batches-header"/>

        <hlayout
            width="100%"
            height="calc(100% - 70px)"
            sclass="captured-batches-layout">

            <!-- CAPTURE OPERATOR SIDEBAR -->
            <div
                width="305px"
                height="100%"
                sclass="captured-batches-sidebar">

                <include
                    src="/captureoperatorsidebar.zul"/>

            </div>

            <!-- MAIN CONTENT -->
            <div
                width="calc(100% - 305px)"
                height="100%"
                sclass="captured-batches-content">

                <!-- PAGE TITLE -->
                <label
                    value="Captured Batches"
                    sclass="captured-batches-page-title"/>

                <!-- CAPTURED BATCH TABLE -->
                <groupbox
                    width="100%"
                    sclass="captured-batches-groupbox">

                    <caption
                        label="Batches"
                        sclass="captured-batches-caption"/>

                    <div
                        sclass="captured-batches-table-container">

                        <listbox
                            id="capturedBatchesList"
                            width="100%"
                            mold="paging"
                            pageSize="10"
                            emptyMessage="No captured batches available."
                            sclass="captured-batches-listbox">

                            <!-- TABLE HEADER -->
                            <listhead
                                sizable="true"
                                height="52px"
                                sclass="captured-batches-listhead">

                                <listheader
                                    label="Batch No"
                                    width="35%"
                                    sclass="captured-batches-listheader"/>

                                <listheader
                                    label="Total Cheques"
                                    width="25%"
                                    sclass="captured-batches-listheader"/>

                                <listheader
                                    label="Status"
                                    width="25%"
                                    sclass="captured-batches-listheader"/>

                            </listhead>

                            <!--
                                Rows are loaded dynamically by
                                CaptureOperatorCapturedBatchesController.
                            -->

                        </listbox>

                    </div>

                </groupbox>

            </div>

        </hlayout>

    </window>

</zk>