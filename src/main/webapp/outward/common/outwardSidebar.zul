<?xml version="1.0" encoding="UTF-8"?>

<zk>

    <vlayout
        id="outwardSidebar"
        sclass="shell-sidebar"
        spacing="0"
        apply="com.iispl.cts.controller.outward.OutwardSidebarController">


        <!-- =================================================
             MAKER / COMMON DASHBOARD
             ================================================= -->

        <div
            id="navDashboard"
            sclass="nav-item">

            <label
                sclass="nav-icon"
                value="⌂"/>

            <label
                sclass="nav-label"
                value="Dashboard"/>

        </div>


        <!-- =================================================
             MAKER
             ================================================= -->

        <div
            id="navMicrRepair"
            sclass="nav-item">

            <label
                sclass="nav-icon"
                value="⚒"/>

            <label
                sclass="nav-label"
                value="MICR Repair"/>

        </div>


        <div
            id="navDataEntry"
            sclass="nav-item">

            <label
                sclass="nav-icon"
                value="☑"/>

            <label
                sclass="nav-label"
                value="Data Entry"/>

        </div>


        <div
            id="navAmountAccount"
            sclass="nav-item">

            <label
                sclass="nav-icon"
                value="▤"/>

            <label
                sclass="nav-label"
                value="Amount And Account"/>

        </div>


        <div
            id="navSendToChecker"
            sclass="nav-item">

            <label
                sclass="nav-icon"
                value="➤"/>

            <label
                sclass="nav-label"
                value="Send to Checker"/>

        </div>


        <!-- =================================================
             CHECKER
             ================================================= -->

        <div
            id="navBatchesQueue"
            sclass="nav-item">

            <label
                sclass="nav-icon"
                value="☑"/>

            <label
                sclass="nav-label"
                value="Batches Queue"/>

        </div>


        <div
            id="navReports"
            sclass="nav-item">

            <label
                sclass="nav-icon"
                value="▤"/>

            <label
                sclass="nav-label"
                value="Reports"/>

        </div>


        <div
            id="navSendToNPCI"
            sclass="nav-item">

            <label
                sclass="nav-icon"
                value="➤"/>

            <label
                sclass="nav-label"
                value="Send to NPCI"/>

        </div>


        <!-- =================================================
             CAPTURE OPERATOR
             ================================================= -->

        <div
            id="navBatchCapture"
            sclass="nav-item">

            <label
                sclass="nav-icon"
                value="▣"/>

            <label
                sclass="nav-label"
                value="Batch Capture"/>

        </div>


        <div
            id="navCapturedBatches"
            sclass="nav-item">

            <label
                sclass="nav-icon"
                value="▦"/>

            <label
                sclass="nav-label"
                value="Captured Batches"/>

        </div>


    </vlayout>

</zk>