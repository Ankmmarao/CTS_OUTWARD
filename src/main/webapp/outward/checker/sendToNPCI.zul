<?xml version="1.0" encoding="UTF-8"?>

<?page title="Send to NPCI"
        contentType="text/html;charset=UTF-8"?>

<?style src="/css/checker.css"?>

<zk>

    <window
        id="sendToNPCIWindow"
        border="none"
        width="100%"
        height="100%"
        apply="com.iispl.cts.controller.outward.checker.CheckerSendToNPCIController">

        <borderlayout width="100%" height="100%">

            <west width="230px">

                <div sclass="checker-sidebar">

                    <div sclass="checker-logo">
                        CTS OUTWARD
                    </div>

                    <div sclass="checker-role">
                        CHECKER
                    </div>

                    <separator height="20px"/>

                    <button
                        label="Dashboard"
                        sclass="sidebar-button"
                        width="100%"
                        onClick="Executions.sendRedirect('/outward/checker/dashboard.zul')"/>

                    <button
                        label="Batches Queue"
                        sclass="sidebar-button"
                        width="100%"
                        onClick="Executions.sendRedirect('/outward/checker/batchesQueue.zul')"/>

                    <button
                        label="Reports"
                        sclass="sidebar-button"
                        width="100%"
                        onClick="Executions.sendRedirect('/outward/checker/reports.zul')"/>

                    <button
                        label="Send to NPCI"
                        sclass="sidebar-button active"
                        width="100%"
                        onClick="Executions.sendRedirect('/outward/checker/sendToNPCI.zul')"/>

                </div>

            </west>


            <center>

                <div sclass="checker-main">

                    <div class="checker-header">

                        <label
                            value="Send to NPCI"
                            sclass="page-title"/>

                    </div>


                    <!-- INFORMATION -->

                    <div sclass="info-card">

                        <label
                            value="Only batches with completed Checker verification can be sent to NPCI."
                            sclass="info-text"/>

                    </div>


                    <!-- BATCH TABLE -->

                    <div sclass="section-card">

                        <label
                            value="Completed Batches"
                            sclass="section-title"/>

                        <separator height="15px"/>

                        <listbox
                            id="npciBatchListbox"
                            width="100%"
                            mold="paging"
                            pageSize="10"
                            emptyMessage="No batches ready to send to NPCI">

                            <listhead>

                                <listheader
                                    label="Batch ID"
                                    width="20%"/>

                                <listheader
                                    label="Total Cheques"
                                    width="15%"/>

                                <listheader
                                    label="Accepted"
                                    width="15%"/>

                                <listheader
                                    label="Rejected"
                                    width="15%"/>

                                <listheader
                                    label="Status"
                                    width="15%"/>

                                <listheader
                                    label="Action"
                                    width="20%"/>

                            </listhead>

                        </listbox>

                    </div>

                </div>

            </center>

        </borderlayout>

    </window>

</zk>