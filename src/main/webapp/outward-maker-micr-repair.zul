<?xml version="1.0" encoding="UTF-8"?>
<?page title="MICR Repair"?>

<zk>

    <window width="100%"
            height="100%"
            border="none"
            apply="com.iispl.cts.controller.outward.OutwardMakerMicrRepairController">

        <borderlayout width="100%"
                      height="100%"
                      style="background:#F4F7FB;">

            <north size="62px">
                <include src="/header.zul"/>
            </north>

            <west size="280px">
                <include src="/makersidebar.zul"/>
            </west>

            <center>

                <vlayout spacing="20px"
                         style="padding:30px;">

                    <label value="MICR Repair"
                           style="font-size:30px;font-weight:bold;color:#122B49;"/>

                    <groupbox width="100%"
                              style="background:white;border:1px solid #DCE5F0;">

                        <listbox id="batchListbox"
                                 width="100%"
                                 emptyMessage="No batches available for MICR Repair.">

                            <listhead>

                                <listheader label="Batch ID"
                                            width="20%"/>

                                <listheader label="Total Cheques"
                                            width="25%"/>

                                <listheader label="MICR Error"
                                            width="25%"/>

                                <listheader label="Action"
                                            width="20%"/>

                            </listhead>

                        </listbox>

                    </groupbox>

                </vlayout>

            </center>

        </borderlayout>

    </window>

</zk>