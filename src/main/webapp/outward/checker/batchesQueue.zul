<?page title="Batches Queue" contentType="text/html;charset=UTF-8"?>

<zk>

    <borderlayout
        width="100%"
        height="100%"
        apply="com.iispl.cts.controller.outward.checker.CheckerBatchesQueueController">

        <!-- ================= HEADER ================= -->
   
        <north
            size="70px"
            border="0">

            <include
                src="/header.zul"
                width="100%"
                height="100%" />

        </north>


        <!-- ================= SIDEBAR ================= -->

        <west
            size="230px"
            border="0">

            <include
                src="/checkersidebar.zul"
                width="100%"
                height="100%" />

        </west>


        <!-- ================= MAIN CONTENT ================= -->

        <center
            border="0"
            autoscroll="true">

            <div
                width="100%"
                style="padding:35px 55px;">

                <!-- PAGE TITLE -->

                <label
                    value="Batches Queue"
                    style="
                        font-size:32px;
                        font-weight:bold;
                        display:block;
                        margin-bottom:30px;" />


                <!-- ================= BATCH TABLE ================= -->

                <listbox
                    id="queueListbox"
                    width="100%"
                    mold="paging"
                    pageSize="10"
                    emptyMessage="No batches found">

                    <listhead>

                        <listheader
                            label="Batch No"
                            width="30%" />

                        <listheader
                            label="Total Cheques"
                            width="25%" />

                        <listheader
                            label="Status"
                            width="25%" />

                        <listheader
                            label="Action"
                            width="20%" />

                    </listhead>

                </listbox>

            </div>

        </center>

    </borderlayout>

</zk>