<?xml version="1.0" encoding="UTF-8"?>

<?page title="Outward Maker Dashboard"?>

<zk>

    <!-- ========================================================= -->
    <!-- OUTWARD MAKER DASHBOARD WINDOW                            -->
    <!-- ========================================================= -->

    <window
        id="outwardMakerDashboardWindow"
        width="100%"
        height="100%"
        border="none"
        apply="com.iispl.cts.controller.outward.OutwardMakerDashboardController">

        <borderlayout
            width="100%"
            height="100%"
            style="background:#F4F7FB;">

            <!-- ================================================= -->
            <!-- HEADER                                            -->
            <!-- ================================================= -->

            <north size="62px">

                <include src="/header.zul"/>

            </north>


            <!-- ================================================= -->
            <!-- SIDEBAR                                           -->
            <!-- ================================================= -->

            <west size="280px">

                <include src="/makersidebar.zul"/>

            </west>


            <!-- ================================================= -->
            <!-- CENTER                                            -->
            <!-- ================================================= -->

            <center>

                <vlayout
                    spacing="22px"
                    width="100%"
                    height="100%"
                    style="
                        padding:32px;
                        overflow:auto;
                    ">


                    <!-- ================================================= -->
                    <!-- PAGE TITLE                                       -->
                    <!-- ================================================= -->

                    <label
                        value="Outward Maker Dashboard"
                        style="
                            font-size:30px;
                            font-weight:bold;
                            color:#122B49;
                        "/>


                    <!-- ================================================= -->
                    <!-- SUMMARY CARDS                                    -->
                    <!-- ================================================= -->

                    <hlayout
                        spacing="20px"
                        width="100%">


                        <!-- ============================================= -->
                        <!-- PENDING DATA ENTRY                            -->
                        <!-- ============================================= -->

                        <groupbox
                            width="300px"
                            height="130px"
                            style="
                                background:white;
                                border:1px solid #DCE5F0;
                                border-radius:8px;
                            ">

                            <vlayout
                                spacing="10px"
                                width="100%"
                                height="100%"
                                style="
                                    padding:20px;
                                    text-align:center;
                                ">

                                <label
                                    value="Pending Data Entry"
                                    style="
                                        font-size:17px;
                                        color:#51657D;
                                    "/>

                                <label
                                    value="8"
                                    style="
                                        font-size:34px;
                                        font-weight:bold;
                                        color:#F39A00;
                                    "/>

                            </vlayout>

                        </groupbox>


                        <!-- ============================================= -->
                        <!-- MICR REPAIR                                   -->
                        <!-- ============================================= -->

                        <groupbox
                            width="300px"
                            height="130px"
                            style="
                                background:white;
                                border:1px solid #DCE5F0;
                                border-radius:8px;
                            ">

                            <vlayout
                                spacing="10px"
                                width="100%"
                                height="100%"
                                style="
                                    padding:20px;
                                    text-align:center;
                                ">

                                <label
                                    value="MICR Repair"
                                    style="
                                        font-size:17px;
                                        color:#51657D;
                                    "/>

                                <label
                                    value="4"
                                    style="
                                        font-size:34px;
                                        font-weight:bold;
                                        color:#E74C3C;
                                    "/>

                            </vlayout>

                        </groupbox>


                        <!-- ============================================= -->
                        <!-- READY TO SUBMIT                               -->
                        <!-- ============================================= -->

                        <groupbox
                            width="300px"
                            height="130px"
                            style="
                                background:white;
                                border:1px solid #DCE5F0;
                                border-radius:8px;
                            ">

                            <vlayout
                                spacing="10px"
                                width="100%"
                                height="100%"
                                style="
                                    padding:20px;
                                    text-align:center;
                                ">

                                <label
                                    value="Ready to Submit"
                                    style="
                                        font-size:17px;
                                        color:#51657D;
                                    "/>

                                <label
                                    value="6"
                                    style="
                                        font-size:34px;
                                        font-weight:bold;
                                        color:#12B76A;
                                    "/>

                            </vlayout>

                        </groupbox>

                    </hlayout>


                    <!-- ================================================= -->
                    <!-- BATCHES GROUPBOX                                -->
                    <!-- ================================================= -->

                    <groupbox
                        width="100%"
                        height="450px"
                        style="
                            background:white;
                            border:1px solid #DCE5F0;
                            border-radius:8px;
                        ">

                        <caption
                            label="Batches"
                            style="
                                font-size:18px;
                                font-weight:bold;
                                color:#122B49;
                            "/>


                        <!-- ================================================= -->
                        <!-- BATCH LISTBOX                                    -->
                        <!--                                                   -->
                        <!-- IMPORTANT:                                      -->
                        <!-- Do NOT use vflex together with height.          -->
                        <!-- ================================================= -->

                        <listbox
                            id="batchListbox"
                            width="100%"
                            height="390px"
                            emptyMessage="No batches available."
                            style="
                                font-size:14px;
                                border:none;
                            ">


                            <!-- ============================================= -->
                            <!-- TABLE HEADER                                  -->
                            <!-- ============================================= -->

                            <listhead>

                                <!-- COLUMN 1 -->
                                <listheader
                                    label="Batch No"
                                    width="13%"/>


                                <!-- COLUMN 2 -->
                                <listheader
                                    label="Total Cheques"
                                    width="13%"/>


                                <!-- COLUMN 3 -->
                                <listheader
                                    label="Errors"
                                    width="24%"/>


                                <!-- COLUMN 4 -->
                                <listheader
                                    label="Status"
                                    width="13%"/>


                                <!-- COLUMN 5 -->
                                <listheader
                                    label="User ID"
                                    width="13%"/>


                                <!-- COLUMN 6 -->
                                <listheader
                                    label="Assignment"
                                    width="12%"/>


                                <!-- COLUMN 7 -->
                                <listheader
                                    label="Action"
                                    width="12%"/>

                            </listhead>


                        </listbox>

                    </groupbox>


                </vlayout>

            </center>

        </borderlayout>

    </window>

</zk>

