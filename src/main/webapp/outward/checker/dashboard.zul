<?xml version="1.0" encoding="UTF-8"?>

<?page title="Outward Checker Dashboard"
        contentType="text/html;charset=UTF-8"?>

<?style src="/css/checker.css"?>

<zk>

    <window
        id="checkerDashboardWindow"
        border="none"
        width="100%"
        height="100%"
        apply="com.iispl.cts.controller.outward.checker.CheckerDashboardController">

        <borderlayout width="100%" height="100%">

            <!-- ================= SIDEBAR ================= -->
            <west width="230px"
                  splittable="false"
                  collapsible="false">

                <div sclass="checker-sidebar">

                    <div sclass="checker-logo">
                        CTS OUTWARD
                    </div>

                    <div sclass="checker-role">
                        CHECKER
                    </div>

                    <separator height="20px"/>

                    <button
                        id="dashboardBtn"
                        label="Dashboard"
                        sclass="sidebar-button active"
                        width="100%"
                        onClick="Executions.sendRedirect('/outward/checker/dashboard.zul')"/>

                    <button
                        id="queueBtn"
                        label="Batches Queue"
                        sclass="sidebar-button"
                        width="100%"
                        onClick="Executions.sendRedirect('/outward/checker/batchesQueue.zul')"/>

                    <button
                        id="reportsBtn"
                        label="Reports"
                        sclass="sidebar-button"
                        width="100%"
                        onClick="Executions.sendRedirect('/outward/checker/reports.zul')"/>

                    <button
                        id="npciBtn"
                        label="Send to NPCI"
                        sclass="sidebar-button"
                        width="100%"
                        onClick="Executions.sendRedirect('/outward/checker/sendToNPCI.zul')"/>

                </div>

            </west>


            <!-- ================= MAIN CONTENT ================= -->
            <center>

                <div sclass="checker-main">

                    <!-- HEADER -->
                    <div sclass="checker-header">

                        <div>
                            <label
                                value="Outward Checker Dashboard"
                                sclass="page-title"/>
                        </div>

                        <div sclass="header-info">

                            <label
                                value="Date: "/>

                            <label
                                id="currentDate"
                                value=""/>

                            <separator orient="vertical"
                                       height="25px"/>

                            <label
                                value="Role: Checker"/>

                        </div>

                    </div>


                    <!-- ================= CARDS ================= -->

                    <div sclass="dashboard-cards">

                        <!-- QUEUE -->
                        <div sclass="dashboard-card">

                            <label
                                value="Batches Queue"
                                sclass="card-title"/>

                            <label
                                id="queueCount"
                                value="0"
                                sclass="card-number"/>

                            <label
                                value="Batches waiting for verification"
                                sclass="card-description"/>

                        </div>


                        <!-- PENDING -->
                        <div sclass="dashboard-card">

                            <label
                                value="Pending Cheques"
                                sclass="card-title"/>

                            <label
                                id="pendingChequeCount"
                                value="0"
                                sclass="card-number"/>

                            <label
                                value="Cheques pending checker action"
                                sclass="card-description"/>

                        </div>


                        <!-- ACCEPTED -->
                        <div sclass="dashboard-card">

                            <label
                                value="Accepted"
                                sclass="card-title"/>

                            <label
                                id="acceptedCount"
                                value="0"
                                sclass="card-number"/>

                            <label
                                value="Cheques accepted"
                                sclass="card-description"/>

                        </div>


                        <!-- REJECTED -->
                        <div sclass="dashboard-card">

                            <label
                                value="Rejected"
                                sclass="card-title"/>

                            <label
                                id="rejectedCount"
                                value="0"
                                sclass="card-number"/>

                            <label
                                value="Cheques rejected"
                                sclass="card-description"/>

                        </div>

                    </div>


                    <!-- ================= RECENT BATCHES ================= -->

                    <div sclass="section-card">

                        <div sclass="section-header">

                            <label
                                value="Batches Waiting for Verification"
                                sclass="section-title"/>

                            <button
                                label="View All"
                                sclass="secondary-button"
                                onClick="Executions.sendRedirect('/outward/checker/batchesQueue.zul')"/>

                        </div>


                        <listbox
                            id="recentBatchListbox"
                            width="100%"
                            mold="paging"
                            pageSize="8"
                            emptyMessage="No batches waiting for checker verification">

                            <listhead>

                                <listheader
                                    label="Batch ID"
                                    width="25%"/>

                                <listheader
                                    label="Total Cheques"
                                    width="15%"/>

                                <listheader
                                    label="Status"
                                    width="20%"/>

                                <listheader
                                    label="Assignment"
                                    width="20%"/>

                                <listheader
                                    label="Action"
                                    width="20%"/>

                            </listhead>

                        </listbox>

                    </div>

                </div>

            </center>

        </borderlayout>

    </window>

</zk>