<?xml version="1.0" encoding="UTF-8"?>
<?page title="MICR Repair"?>

<zk>
    <!-- Reset default browser & ZK margins to remove spacing/gaps -->
    <style><![CDATA[
        html, body {
            margin: 0 !important;
            padding: 0 !important;
            height: 100% !important;
            overflow: hidden !important;
            background: #F4F7FB;
        }

        .z-window-embedded-cnt, .z-window-content {
            padding: 0 !important;
        }

        .z-north, .z-west, .z-center {
            border: none !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .z-north-body, .z-west-body, .z-center-body {
            padding: 0 !important;
            margin: 0 !important;
            height: 100% !important;
        }

        .z-west {
            background: #081B33 !important;
        }

        /* Listbox styling matching maker UI */
        .micr-repair-listbox .z-listheader {
            background: #0091FF !important;
            color: #FFFFFF !important;
            font-weight: 700 !important;
            font-size: 13px !important;
            border-right: 1px solid rgba(255, 255, 255, 0.2) !important;
            height: 38px !important;
        }
        .micr-repair-listbox .z-listheader-content {
            color: #FFFFFF !important;
            font-weight: 700 !important;
            padding: 8px 12px !important;
        }
        .micr-repair-listbox .z-listcell {
            font-size: 13px !important;
            color: #1E293B !important;
            padding: 10px 12px !important;
            border-bottom: 1px solid #E2E8F0 !important;
        }
        .micr-repair-listbox .z-listitem:hover > .z-listcell {
            background: #F8FAFC !important;
        }
    ]]></style>

    <window
        width="100%"
        height="100%"
        border="none"
        style="padding:0;margin:0;"
        apply="com.iispl.cts.controller.outward.OutwardMakerMicrRepairController">

        <borderlayout
            width="100%"
            height="100%"
            style="background:#F4F7FB;margin:0;padding:0;">

            <!-- HEADER -->
            <north 
                size="62px" 
                border="none" 
                margins="0,0,0,0" 
                style="padding:0;margin:0;border:none;overflow:hidden;">
                <include src="/header.zul" style="display:block; width:100%; height:62px;"/>
            </north>

            <!-- MAKER SIDEBAR -->
            <west 
                size="280px" 
                border="none" 
                margins="0,0,0,0" 
                style="padding:0;margin:0;border:none;background:#081B33;">
                <include src="/makersidebar.zul" activeTab="micrRepair" style="display:block; width:280px; height:100%;"/>
            </west>

            <!-- MAIN CONTENT -->
            <center 
                border="none" 
                margins="0,0,0,0" 
                style="overflow:auto;border:none;background:#F4F7FB;">

                <vlayout 
                    spacing="18px"
                    style="padding:24px 30px; box-sizing:border-box;">

                    <!-- PAGE HEADING -->
                    <label 
                        value="MICR Repair"
                        style="font-size:26px;
                               font-weight:700;
                               color:#0F172A;
                               letter-spacing:-0.3px;"/>

                    <!-- BATCH TABLE CARD -->
                    <div 
                        width="100%"
                        style="background:white;
                               border:1px solid #DCE5F0;
                               border-radius:6px;
                               padding:16px;
                               box-sizing:border-box;
                               box-shadow:0 1px 3px rgba(16,24,40,0.04);">

                        <listbox 
                            id="batchListbox" 
                            width="100%"
                            sclass="micr-repair-listbox"
                            style="border:1px solid #E2E8F0; border-radius:6px; overflow:hidden;"
                            emptyMessage="No batches available for MICR Repair."
                            mold="paging"
                            pageSize="10">

                            <listhead>
                                <listheader label="Batch ID" width="25%" />
                                <listheader label="Total Cheques" width="25%" />
                                <listheader label="MICR Error" width="25%" />
                                <listheader label="Action" width="25%" />
                            </listhead>

                        </listbox>

                    </div>

                </vlayout>

            </center>

        </borderlayout>

    </window>

</zk>