<?xml version="1.0" encoding="UTF-8"?>

<?page title="Outward Checker Dashboard"?>

<zk>

    <borderlayout width="100%"
                  height="100%"
                  style="background:#F4F7FB;">

        <!-- HEADER -->

        <north size="62px">
            <include src="/header.zul"/>
        </north>


        <!-- CHECKER SIDEBAR -->

        <west size="280px">
            <include src="/checkersidebar.zul"/>
        </west>


        <!-- CONTENT -->

        <center>

            <vlayout spacing="22px"
                     style="padding:30px;">

                <label value="Outward Checker Dashboard"
                       style="font-size:30px;
                              font-weight:bold;
                              color:#122B49;"/>


                <!-- SUMMARY CARDS -->

                <hlayout spacing="20px">

                    <!-- PENDING -->

                    <groupbox width="31%"
                              height="145px"
                              style="background:white;
                                     border:1px solid #DCE5F0;
                                     border-radius:8px;">

                        <vlayout align="center"
                                 spacing="10px"
                                 style="padding:25px;">

                            <label value="Pending Verification"
                                   style="font-size:17px;
                                          color:#51657D;"/>

                            <label value="1"
                                   style="font-size:38px;
                                          font-weight:bold;
                                          color:#F59E0B;"/>

                        </vlayout>

                    </groupbox>


                    <!-- VERIFIED -->

                    <groupbox width="31%"
                              height="145px"
                              style="background:white;
                                     border:1px solid #DCE5F0;
                                     border-radius:8px;">

                        <vlayout align="center"
                                 spacing="10px"
                                 style="padding:25px;">

                            <label value="Verified / Completed"
                                   style="font-size:17px;
                                          color:#51657D;"/>

                            <label value="0"
                                   style="font-size:38px;
                                          font-weight:bold;
                                          color:#12B76A;"/>

                        </vlayout>

                    </groupbox>


                    <!-- TOTAL -->

                    <groupbox width="31%"
                              height="145px"
                              style="background:white;
                                     border:1px solid #DCE5F0;
                                     border-radius:8px;">

                        <vlayout align="center"
                                 spacing="10px"
                                 style="padding:25px;">

                            <label value="Total Batches Handled"
                                   style="font-size:17px;
                                          color:#51657D;"/>

                            <label value="1"
                                   style="font-size:38px;
                                          font-weight:bold;
                                          color:#175CD3;"/>

                        </vlayout>

                    </groupbox>

                </hlayout>


                <!-- PENDING TABLE -->

                <groupbox width="100%"
                          style="background:white;
                                 border:1px solid #DCE5F0;
                                 border-radius:8px;">

                    <caption label="Batches Pending for Verification (1)"
                             style="font-size:19px;
                                    font-weight:bold;"/>


                    <listbox width="100%"
                             emptyMessage="No batches pending for verification.">

                        <listhead>

                            <listheader label="Batch ID"
                                        width="18%"/>

                            <listheader label="Total Cheques"
                                        width="18%"/>

                            <listheader label="Created By / Maker"
                                        width="25%"/>

                            <listheader label="Status"
                                        width="22%"/>

                            <listheader label="Action"
                                        width="17%"/>

                        </listhead>


                        <listitem>

                            <listcell label="B001"/>

                            <listcell label="12"/>

                            <listcell label="maker456"/>


                            <listcell>

                                <label value="Submitted to Checker"
                                       style="background:#FFF4E5;
                                              color:#E66A00;
                                              padding:7px 12px;
                                              border-radius:5px;
                                              font-weight:bold;"/>

                            </listcell>


                            <listcell>

                                <button label="◉ Open"
                                        width="100px"
                                        style="background:white;
                                               color:#175CD3;
                                               border:1px solid #175CD3;"
                                        onClick='Executions.sendRedirect("outward-checker-verification.zul")'/>

                            </listcell>

                        </listitem>

                    </listbox>

                </groupbox>

            </vlayout>

        </center>

    </borderlayout>

</zk>