<?xml version="1.0" encoding="UTF-8"?>
<?page title="Data Entry Detail"?>

<zk>
    <!-- Reset default browser & ZK margins to remove spacing/scrollbars -->
    <style>
        html, body {
            margin: 0 !important;
            padding: 0 !important;
            height: 100% !important;
            overflow: hidden !important;
            background: #F4F7FB;
        }
        .z-window-embedded-cnt, .z-window-content {
            padding: 0 !important;
        }
        .z-north, .z-west, .z-center {
            border: none !important;
        }
        .z-north-body, .z-west-body, .z-center-body {
            padding: 0 !important;
            margin: 0 !important;
        }

        /* Equal-height compact card container */
        .equal-card {
            background: #FFFFFF !important;
            border: 1px solid #DCE5F0 !important;
            border-radius: 6px !important;
            box-shadow: 0 1px 3px rgba(16, 24, 40, 0.04) !important;
        }
        .equal-card > .z-groupbox-content {
            padding: 0 !important;
            height: 100% !important;
        }

        /* Professional banking input boxes */
        .single-field-box {
            height: 38px !important;
            font-size: 13px !important;
            border: 1px solid #CBD5E1 !important;
            border-radius: 6px !important;
            padding: 6px 12px !important;
            color: #0F172A !important;
            background: #F8FAFC !important;
            font-weight: 500 !important;
            transition: all 0.2s ease !important;
        }
        .single-field-box:focus {
            background: #FFFFFF !important;
            border-color: #2457D6 !important;
            box-shadow: 0 0 0 3px rgba(36, 87, 214, 0.15) !important;
            outline: none !important;
        }

        /* Prominent field labels */
        .single-field-label {
            font-size: 13px !important;
            font-weight: 700 !important;
            color: #1E293B !important;
            letter-spacing: 0.2px;
        }
        .label-star {
            color: #DC2626 !important;
            font-weight: 700 !important;
            font-size: 13px !important;
            margin-left: 2px;
        }

/* Image toolbar buttons */

.icon-symbol-btn {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    color: #334155 !important;
    font-size: 18px !important;
    font-weight: bold !important;
    cursor: pointer !important;
    height: 30px !important;
    padding: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: color 0.15s ease, transform 0.1s ease !important;
}
.icon-symbol-btn:hover {
    background: #E2E8F0 !important;
    border-radius: 4px !important;
    color: #0F172A !important;
}
    </style>

    <window
        width="100%"
        height="100vh"
        border="none"
        style="padding:0;margin:0;"
        apply="com.iispl.cts.controller.outward.OutwardMakerDataEntryDetailController">

        <borderlayout
            width="100%"
            height="100%"
            style="background:#F4F7FB;margin:0;padding:0;">

            <!-- ================= 1. EXPANDED HEADER (72PX) ================= -->
            <north 
                size="72px" 
                border="none" 
                margins="0,0,0,0" 
                style="padding:0;margin:0;border:none;overflow:hidden;">
                <include src="/header.zul"/>
            </north>

            <!-- ================= 2. SIDEBAR NAVIGATION ================= -->
            <west 
                size="240px" 
                border="none" 
                margins="0,0,0,0" 
                style="padding:0;margin:0;border:none;background:#0b1e36;">
                <include src="/makersidebar.zul"/>
            </west>

            <!-- ================= 3. CENTER WORKSPACE ================= -->
            <center 
                border="none" 
                margins="0,0,0,0" 
                style="overflow:hidden;border:none;background:#F4F7FB;">
                
                <vlayout
                    spacing="8px"
                    style="padding:10px 16px; box-sizing:border-box;">

                    <!-- ================= BATCH HEADER STRIP ================= -->
                    <groupbox
                        width="100%"
                        style="background:white;border:1px solid #DCE5F0;border-radius:6px;">
                        <hlayout
                            width="100%"
                            valign="middle"
                            style="padding:4px 14px;">
                            <label
                                value="Batch ID : "
                                style="font-size:14px;font-weight:bold;color:#334155;"/>
                            <label
                                id="batchIdLabel"
                                value=""
                                style="font-size:15px;font-weight:bold;color:#175CD3;"/>
                            <space hflex="1"/>
                            <label
                                id="chequeProgressLabel"
                                value=""
                                style="font-size:14px;font-weight:bold;color:#175CD3;"/>
                        </hlayout>
                    </groupbox>

                    <!-- ================= MAIN SPLIT ROW (HEIGHT: 430PX) ================= -->
                    <hlayout
                        width="100%"
                        height="430px"
                        spacing="14px"
                        valign="top">

                        <!-- ================= LEFT: SCANNED CHEQUE CARD ================= -->
                        <groupbox
                            hflex="7"
                            height="430px"
                            sclass="equal-card">
                            <caption label="Scanned Cheque" style="font-size:13px;font-weight:bold;color:#122B49;"/>

                            <vlayout
                                width="100%"
                                height="100%"
                                spacing="6px"
                                style="padding:6px;box-sizing:border-box;justify-content:space-between;">

                                <!-- CHEQUE CANVAS (STRICTLY CONFINED TO CARD DIMENSIONS) -->
                                <vlayout
                                    width="100%"
                                    height="340px"
                                    style="overflow:hidden; text-align:center; align-items:center; justify-content:center; background:#F8FAFC; border:1px solid #EAECF0; border-radius:4px; padding:6px; box-sizing:border-box;">
                                    <image
                                        id="frontImage"
                                        src="https://commons.wikimedia.org/wiki/Special:Redirect/file/Subcheck_FRONT.png"
                                        width="100%"
                                        height="100%"
                                        visible="true"
                                        style="object-fit:contain; max-width:100%; max-height:100%; display:block; margin:auto;"/>
                                    <image
                                        id="backImage"
                                        src="https://placehold.co/900x400?text=Cheque+Back"
                                        width="100%"
                                        height="100%"
                                        visible="false"
                                        style="object-fit:contain; max-width:100%; max-height:100%; display:block; margin:auto;"/>
                                </vlayout>

                                <!-- COMPACT TOOLBAR DIRECTLY UNDER CHEQUE -->
                          
<!-- COMPACT TOOLBAR DIRECTLY UNDER CHEQUE -->
<hlayout
    width="100%"
    spacing="4px"
    style="justify-content:center;padding:2px 0;">
    <button id="frontImageButton" label="Front" hflex="1" sclass="img-tool-btn"/>
    <button id="backImageButton" label="Back" hflex="1" sclass="img-tool-btn"/>
    <button id="zoomInButton" label="+" tooltiptext="Zoom In" hflex="1" sclass="icon-symbol-btn"/>
    <button id="zoomOutButton" label="−" tooltiptext="Zoom Out" hflex="1" sclass="icon-symbol-btn"/>
    <button id="rotateButton" label="↻" tooltiptext="Rotate" hflex="1" sclass="icon-symbol-btn"/>
</hlayout>              </vlayout>
                        </groupbox>

                        <!-- ================= RIGHT: CHEQUE DATA VERIFICATION FORM ================= -->
                        <groupbox
                            hflex="7"
                            height="430px"
                            sclass="equal-card">
                            <caption label="Cheque Data Verification" style="font-size:13px;font-weight:bold;color:#122B49;"/>

                            <vlayout
                                width="100%"
                                height="100%"
                                style="padding:14px 18px;box-sizing:border-box;justify-content:space-between;">

                               

                                <!-- ROW 1: CHEQUE NUMBER & ACCOUNT NUMBER -->
                                <hlayout width="100%" spacing="16px">
                                    <vlayout hflex="1" spacing="4px">
                                        <hlayout spacing="0" valign="middle">
                                            <label value="Cheque Number" sclass="single-field-label"/>
                                            <label value="*" sclass="label-star"/>
                                        </hlayout>
                                        <textbox
                                            id="chequeNumberTextbox"
                                            width="100%"
                                            placeholder="Enter cheque number"
                                            sclass="single-field-box"/>
                                    </vlayout>
                                    <vlayout hflex="1" spacing="4px">
                                        <hlayout spacing="0" valign="middle">
                                            <label value="Account Number" sclass="single-field-label"/>
                                            <label value="*" sclass="label-star"/>
                                        </hlayout>
                                        <textbox
                                            id="accountNumberTextbox"
                                            width="100%"
                                            placeholder="Enter account number"
                                            sclass="single-field-box"/>
                                    </vlayout>
                                </hlayout>

                                <!-- ROW 2: CHEQUE DATE & DRAWER NAME -->
                                <hlayout width="100%" spacing="16px">
                                    <vlayout hflex="1" spacing="4px">
                                        <hlayout spacing="0" valign="middle">
                                            <label value="Cheque Date" sclass="single-field-label"/>
                                            <label value="*" sclass="label-star"/>
                                        </hlayout>
                                        <textbox
                                            id="chequeDateTextbox"
                                            width="100%"
                                            placeholder="DD-MM-YYYY"
                                            sclass="single-field-box"/>
                                    </vlayout>
                                    <vlayout hflex="1" spacing="4px">
                                        <hlayout spacing="0" valign="middle">
                                            <label value="Drawer Name" sclass="single-field-label"/>
                                            <label value="*" sclass="label-star"/>
                                        </hlayout>
                                        <textbox
                                            id="drawerNameTextbox"
                                            width="100%"
                                            placeholder="Enter drawer name"
                                            sclass="single-field-box"/>
                                    </vlayout>
                                </hlayout>

                                <!-- ROW 3: PAYEE NAME & AMOUNT -->
                                <hlayout width="100%" spacing="16px">
                                    <vlayout hflex="1" spacing="4px">
                                        <hlayout spacing="0" valign="middle">
                                            <label value="Payee Name" sclass="single-field-label"/>
                                            <label value="*" sclass="label-star"/>
                                        </hlayout>
                                        <textbox
                                            id="payeeNameTextbox"
                                            width="100%"
                                            placeholder="Enter payee name"
                                            sclass="single-field-box"/>
                                    </vlayout>
                                    <vlayout hflex="1" spacing="4px">
                                        <hlayout spacing="0" valign="middle">
                                            <label value="Amount (₹)" sclass="single-field-label"/>
                                            <label value="*" sclass="label-star"/>
                                        </hlayout>
                                        <decimalbox
                                            id="amountTextbox"
                                            width="100%"
                                            format="###,##0.00"
                                            placeholder="0.00"
                                            sclass="single-field-box"/>
                                    </vlayout>
                                </hlayout>

                                <!-- ROW 4: AMOUNT IN WORDS -->
                                <vlayout width="100%" spacing="4px">
                                    <hlayout spacing="0" valign="middle">
                                        <label value="Amount in Words" sclass="single-field-label"/>
                                        <label value="*" sclass="label-star"/>
                                    </hlayout>
                                    <textbox
                                        id="amountInWordsTextbox"
                                        width="100%"
                                        placeholder="Enter amount in words"
                                        sclass="single-field-box"/>
                                </vlayout>

                            </vlayout>
                        </groupbox>

                    </hlayout>

                    <!-- ================= 4. BOTTOM ACTION CONTROL BAR (REJECT BESIDE SAVE) ================= -->
                    <hlayout
                        width="100%"
                        valign="middle"
                        style="padding-top:4px;align-items:center;">

                        <button
                            id="prevButton"
                            label="Prev"
                            width="90px"
                            style="height:38px;font-size:13px;font-weight:600;cursor:pointer;"/>

                        <button
                            id="saveNextButton"
                            label="💾 Save &amp; Next"
                            width="145px"
                            style="height:38px;background:#2457D6;color:white;border:none;margin-left:8px;font-size:13px;font-weight:bold;cursor:pointer;"/>

                        <button
                            id="rejectButton"
                            label="Reject"
                            width="110px"
                            style="height:38px;background:white;color:#D92D20;border:1px solid #D92D20;margin-left:8px;font-size:13px;font-weight:bold;cursor:pointer;"/>

                        <!-- Hidden autowire buttons for controller safety -->
                        <button id="nextButton" visible="false"/>
                        <button id="backButton" visible="false"/>
                    </hlayout>

                </vlayout>
            </center>

        </borderlayout>
    </window>
</zk>