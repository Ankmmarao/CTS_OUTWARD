<?page title="CTS Application"?>

<zk>

    <window
        border="normal"
        width="100%"
        height="100%"
        style="padding:40px; overflow:auto;">

        <vlayout
            spacing="15px"
            width="100%">

            <label
                value="CTS Application"
                style="font-size:30px;font-weight:bold;"/>


            <!-- ================= CAPTURE OPERATOR ================= -->

            <label
                value="Capture Operator Flow"
                style="font-size:20px;
                       font-weight:bold;
                       margin-top:20px;"/>

            <button
                label="Batch Capture"
                width="250px"
                onClick='Executions.sendRedirect("capture-operator-batch-capture.zul")'/>

            <button
                label="Captured Batches"
                width="250px"
                onClick='Executions.sendRedirect("capture-operator-captured-batches.zul")'/>


            <!-- ================= OUTWARD CHECKER ================= -->

            <label
                value="Outward Checker Flow"
                style="font-size:20px;
                       font-weight:bold;
                       margin-top:20px;"/>

            <button
                label="Checker Dashboard"
                width="250px"
                onClick='Executions.sendRedirect("outward/checker/dashboard.zul")'/>

            <button
                label="Batches Queue"
                width="250px"
                onClick='Executions.sendRedirect("outward/checker/batchesQueue.zul")'/>

            <button
                label="CBS Validation"
                width="250px"
                onClick='Executions.sendRedirect("outward/checker/chequeVerification.zul")'/>

            <button
                label="Reports"
                width="250px"
                onClick='Executions.sendRedirect("outward/checker/reports.zul")'/>

            <button
                label="Send to NPCI"
                width="250px"
                onClick='Executions.sendRedirect("outward/checker/sendToNPCI.zul")'/>


            <!-- ================= OUTWARD MAKER ================= -->

            <label
                value="Outward Maker Flow"
                style="font-size:20px;
                       font-weight:bold;">

            </label>

            <button
                label="Maker Dashboard"
                width="250px"
                onClick='Executions.sendRedirect("outward-maker-dashboard.zul")'/>

            <button
                label="Data Entry"
                width="250px"
                onClick='Executions.sendRedirect("outward-maker-data-entry.zul")'/>

            <button
                label="Data Entry Detail"
                width="250px"
                onClick='Executions.sendRedirect("outward-maker-data-entry-detail.zul")'/>

            <button
                label="MICR Repair"
                width="250px"
                onClick='Executions.sendRedirect("outward-maker-micr-repair.zul")'/>

            <button
                label="MICR Repair Detail"
                width="250px"
                onClick='Executions.sendRedirect("outward-maker-micr-repair-detail.zul")'/>

            <button
                label="Amount &amp; Account"
                width="250px"
                onClick='Executions.sendRedirect("outward-maker-amount-account.zul")'/>

            <button
                label="Amount &amp; Account Detail"
                width="250px"
                onClick='Executions.sendRedirect("outward-maker-amount-account-detail.zul")'/>

            <button
                label="Send to Checker"
                width="250px"
                onClick='Executions.sendRedirect("outward-maker-send-to-checker.zul")'/>


            <!-- ================= AI ASSISTANT ================= -->

            <label
                value="AI Assistant"
                style="font-size:20px;
                       font-weight:bold;
                       margin-top:20px;"/>

            <button
                label="Open CTS AI Assistant"
                width="250px"
                onClick='Executions.sendRedirect("ai-chatbot.zul")'/>

        </vlayout>

    </window>

</zk>