<?page title="Capture Operator - Batch Capture"
    contentType="text/html;charset=UTF-8"?>

<zk>

    <!-- PAGE CSS -->
    <style src="/css/outward-maker/batch-capture.css"/>

    <window
        id="batchCaptureWindow"
        width="100%"
        height="100%"
        border="none"
        apply="com.iispl.cts.controller.outward.CaptureOperatorBatchCaptureController"
        sclass="batch-capture-window">

        <!-- HEADER -->
        <include
            src="/header.zul"
            width="100%"
            sclass="batch-capture-header" />

        <hlayout
            width="100%"
            height="calc(100% - 60px)"
            sclass="batch-capture-layout">

            <!-- SIDEBAR -->
            <include
                src="/captureoperatorsidebar.zul"
                width="230px"
                height="100%"
                sclass="batch-capture-sidebar" />

            <!-- MAIN CONTENT -->
            <vlayout
                width="100%"
                height="100%"
                spacing="20px"
                sclass="batch-capture-content">

                <!-- PAGE TITLE -->
                <label
                    value="Batch Capture"
                    sclass="batch-capture-page-title" />

                <!-- BATCH DETAILS FORM -->
                <groupbox
                    width="100%"
                    mold="3d"
                    sclass="batch-capture-groupbox">

                    <caption
                        label="Batch Details"
                        sclass="batch-capture-caption" />

                    <grid
                        width="100%"
                        sclass="batch-capture-grid">

                        <columns>
                            <column width="180px" />
                            <column />
                        </columns>

                        <rows>

                            <!-- BRANCH CODE -->
                            <row sclass="batch-capture-row">

                                <label
                                    value="Branch Code"
                                    sclass="batch-capture-field-label" />

                                <combobox
                                    id="branchCodeCombo"
                                    width="300px"
                                    placeholder="Select Branch Code"
                                    autodrop="true"
                                    sclass="batch-capture-input" />

                            </row>

                            <!-- BRANCH NAME -->
                            <row sclass="batch-capture-row">

                                <label
                                    value="Branch Name"
                                    sclass="batch-capture-field-label" />

                                <textbox
                                    id="branchNameTextbox"
                                    width="300px"
                                    readonly="true"
                                    sclass="batch-capture-input" />

                            </row>

                            <!-- NUMBER OF CHEQUES -->
                            <row sclass="batch-capture-row">

                                <label
                                    value="Number of Cheques"
                                    sclass="batch-capture-field-label" />

                                <intbox
                                    id="numberOfCheques"
                                    width="300px"
                                    placeholder="Enter number of cheques"
                                    constraint="no negative"
                                    sclass="batch-capture-input" />

                            </row>

                            <!-- BATCH FOLDER -->
                            <row sclass="batch-capture-row">

                                <label
                                    value="Batch Folder Path"
                                    sclass="batch-capture-field-label" />

                                <textbox
                                    id="batchFolderPath"
                                    width="600px"
                                    value="C:\Users"
                                    placeholder="Enter batch folder path"
                                    sclass="batch-capture-folder-input" />

                            </row>

                            <!-- XML INFORMATION -->
                            <row sclass="batch-capture-row">

                                <label value="" />

                                <label
                                    value="XML will be detected automatically from the selected folder."
                                    sclass="batch-capture-xml-info" />

                            </row>

                            <!-- CAPTURE BUTTON -->
                            <row sclass="batch-capture-row">

                                <label value="" />

                                <button
                                    id="capturedBatchButton"
                                    label="Capture Batch"
                                    width="180px"
                                    height="40px"
                                    sclass="batch-capture-button" />

                            </row>

                        </rows>

                    </grid>

                </groupbox>

            </vlayout>

        </hlayout>

    </window>

</zk>