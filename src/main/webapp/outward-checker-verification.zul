<?xml version="1.0" encoding="UTF-8"?>

<?page title="Batch Verification"?>

<zk>

    <borderlayout width="100%"
                  height="100%"
                  style="background:#F4F7FB;">

        <!-- HEADER -->

        <north size="62px">
            <include src="/header.zul"/>
        </north>


        <!-- SIDEBAR -->

        <west size="280px">
            <include src="/checkersidebar.zul"/>
        </west>


        <!-- CONTENT -->

        <center>

            <vlayout spacing="20px"
                     style="padding:30px;">

                <!-- PAGE TITLE -->

                <label value="Batch Verification"
                       style="font-size:30px;
                              font-weight:bold;
                              color:#122B49;"/>


                <!-- MAIN CARD -->

                <groupbox width="100%"
                          style="background:white;
                                 border:1px solid #DCE5F0;
                                 border-radius:8px;">

                    <vlayout spacing="20px"
                             style="padding:25px;">


                        <!-- BATCH HEADER -->

                        <hlayout width="100%"
                                 style="background:#F8FAFC;
                                        border:1px solid #DCE5F0;
                                        border-radius:8px;
                                        padding:18px 25px;">

                            <label value="Batch ID : "
                                   style="font-size:18px;
                                          font-weight:bold;"/>

                            <label value="B006"
                                   style="font-size:22px;
                                          font-weight:bold;
                                          color:#175CD3;"/>

                            <space hflex="1"/>

                            <label value="Total Cheques: 12"
                                   style="font-size:18px;
                                          font-weight:bold;
                                          color:#175CD3;"/>

                        </hlayout>


                        <!-- CHEQUE + DETAILS -->

                        <hlayout width="100%"
                                 spacing="30px">


                            <!-- LEFT SIDE -->

                            <vlayout hflex="1"
                                     spacing="12px">

                                <label value="Scanned Cheque"
                                       style="font-size:20px;
                                              font-weight:bold;"/>


                                <groupbox width="100%"
                                          height="390px"
                                          style="background:white;
                                                 border:1px solid #DCE5F0;
                                                 border-radius:7px;">

                                    <vlayout width="100%"
                                             align="center"
                                             spacing="12px">

                                        <!-- IMAGE CONTROLS -->

                                        <hlayout spacing="10px">

                                            <button label="⌕ Zoom In"
                                                    width="115px"/>

                                            <button label="⌕ Zoom Out"
                                                    width="115px"/>

                                            <button label="↻ Rotate"
                                                    width="105px"/>

                                        </hlayout>


                                        <!-- CHEQUE IMAGE -->

                                        <image src="/images/cheque-front.jpg"
                                               width="95%"
                                               height="315px"
                                               style="object-fit:contain;"/>

                                    </vlayout>

                                </groupbox>

                            </vlayout>


                            <!-- RIGHT SIDE -->

                            <vlayout width="450px"
                                     spacing="12px">

                                <label value="Cheque Details"
                                       style="font-size:20px;
                                              font-weight:bold;"/>


                                <groupbox width="450px"
                                          height="390px"
                                          style="background:white;
                                                 border:1px solid #DCE5F0;
                                                 border-radius:7px;">

                                    <vlayout spacing="22px"
                                             style="padding:25px;">


                                        <!-- CHEQUE NUMBER -->

                                        <grid width="100%">

                                            <columns>

                                                <column width="150px"/>

                                                <column width="20px"/>

                                                <column/>

                                            </columns>

                                            <rows>

                                                <row>

                                                    <label value="Cheque Number"
                                                           style="font-size:16px;
                                                                  color:#667085;"/>

                                                    <label value=":"/>

                                                    <label value="123456"
                                                           style="font-size:16px;
                                                                  font-weight:bold;"/>

                                                </row>


                                                <!-- DATE -->

                                                <row>

                                                    <label value="Cheque Date"
                                                           style="font-size:16px;
                                                                  color:#667085;"/>

                                                    <label value=":"/>

                                                    <label value="21-06-2025"
                                                           style="font-size:16px;
                                                                  font-weight:bold;"/>

                                                </row>


                                                <!-- AMOUNT -->

                                                <row>

                                                    <label value="Cheque Amount"
                                                           style="font-size:16px;
                                                                  color:#667085;"/>

                                                    <label value=":"/>

                                                    <label value="₹ 10,00,000.00"
                                                           style="font-size:17px;
                                                                  font-weight:bold;
                                                                  color:#039855;"/>

                                                </row>


                                                <!-- DRAWEE BANK -->

                                                <row>

                                                    <label value="Drawee Bank"
                                                           style="font-size:16px;
                                                                  color:#667085;"/>

                                                    <label value=":"/>

                                                    <label value="STATE BANK OF INDIA&#10;(SBIN0001234)"
                                                           multiline="true"
                                                           style="font-size:16px;
                                                                  font-weight:bold;"/>

                                                </row>

                                            </rows>

                                        </grid>

                                    </vlayout>

                                </groupbox>

                            </vlayout>

                        </hlayout>


                        <separator/>


                        <!-- ACTION BUTTONS -->

                        <hlayout width="100%"
                                 valign="middle">

                            <button label="← Back to Queue"
                                    width="150px"
                                    onClick='Executions.sendRedirect("outward-checker-dashboard.zul")'
                                    style="background:white;
                                           color:#475467;
                                           border:1px solid #D0D5DD;"/>

                            <space hflex="1"/>


                            <button label="⊗ Reject"
                                    width="130px"
                                    style="background:white;
                                           color:#D92D20;
                                           border:1px solid #D92D20;"/>


                            <button label="★ Send to Maker"
                                    width="155px"
                                    style="background:white;
                                           color:#D97706;
                                           border:1px solid #F59E0B;"/>


                            <button label="✓ Approve &amp; Complete Verification"
                                    width="270px"
                                    style="background:#12B76A;
                                           color:white;
                                           border:none;"/>

                        </hlayout>

                    </vlayout>

                </groupbox>

            </vlayout>

        </center>

    </borderlayout>

</zk>