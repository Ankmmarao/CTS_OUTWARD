<?page title="Batches Queue" contentType="text/html;charset=UTF-8"?>

<zk apply="com.iispl.cts.controller.outward.checker.CheckerBatchesQueueController">

    <borderlayout width="100%"
                  height="100%"
                  style="background:#F8FAFC;">

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <north size="70px"
               border="0">

            <include src="/header.zul"
                     width="100%"
                     height="100%"/>

        </north>


        <!-- ===================================================== -->
        <!-- CHECKER SIDEBAR -->
        <!-- ===================================================== -->

        <west size="300px"
              border="0">

            <include src="/checkersidebar.zul"
                     width="100%"
                     height="100%"/>

        </west>


        <!-- ===================================================== -->
        <!-- MAIN CONTENT -->
        <!-- ===================================================== -->

        <center border="0"
                autoscroll="true">

            <div width="100%"
                 style="padding:35px 55px;background:#F8FAFC;">

                <!-- PAGE TITLE -->

                <label value="Batches Queue"
                       style="font-size:32px;
                              font-weight:bold;
                              color:#0B2A4A;
                              display:block;
                              margin-bottom:30px;"/>


                <!-- ================================================= -->
                <!-- QUEUE BOX -->
                <!-- ================================================= -->

                <groupbox width="100%"
                          style="background:white;
                                 border:1px solid #D5DDE7;
                                 border-radius:5px;">

                    <caption label="Checker Batch Queue"
                             style="font-size:21px;
                                    font-weight:bold;
                                    color:#173B63;"/>


                    <div style="padding:18px;">

                        <!-- ================================================= -->
                        <!-- BATCH LIST -->
                        <!-- ================================================= -->

                        <listbox id="queueListbox"
                                 width="100%"
                                 mold="paging"
                                 pageSize="10"
                                 emptyMessage="No batches found"
                                 style="border:1px solid #D7DFE8;
                                        font-size:16px;">

                            <listhead sizable="true"
                                      height="52px">


                                <!-- BATCH NUMBER -->

                                <listheader label="Batch No"
                                            width="25%"
                                            style="background:#078FE5;
                                                   color:white;
                                                   font-size:16px;
                                                   font-weight:bold;"/>


                                <!-- BRANCH -->

                                <listheader label="Branch"
                                            width="18%"
                                            style="background:#078FE5;
                                                   color:white;
                                                   font-size:16px;
                                                   font-weight:bold;"/>


                                <!-- TOTAL CHEQUES -->

                                <listheader label="Total Cheques"
                                            width="17%"
                                            style="background:#078FE5;
                                                   color:white;
                                                   font-size:16px;
                                                   font-weight:bold;"/>


                                <!-- STATUS -->

                                <listheader label="Status"
                                            width="18%"
                                            style="background:#078FE5;
                                                   color:white;
                                                   font-size:16px;
                                                   font-weight:bold;"/>


                                <!-- ACTION -->

                                <listheader label="Action"
                                            width="22%"
                                            style="background:#078FE5;
                                                   color:white;
                                                   font-size:16px;
                                                   font-weight:bold;"/>

                            </listhead>

                        </listbox>

                    </div>

                </groupbox>

            </div>

        </center>

    </borderlayout>

</zk>