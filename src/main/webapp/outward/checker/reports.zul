<?xml version="1.0" encoding="UTF-8"?>

<?page title="Checker Reports"
        contentType="text/html;charset=UTF-8"?>

<?style src="/css/checker.css"?>

<zk>

    <window
        id="checkerReportsWindow"
        border="none"
        width="100%"
        height="100%"
        apply="com.iispl.cts.controller.outward.checker.CheckerReportsController">

        <borderlayout width="100%" height="100%">

            <!-- =====================================================
                 LEFT SIDEBAR
                 ===================================================== -->

            <west width="230px">

                <div sclass="checker-sidebar">

                    <div sclass="checker-logo">
                        CTS OUTWARD
                    </div>

                    <div sclass="checker-role">
                        CHECKER
                    </div>

                    <separator height="20px"/>

                    <button
                        label="Dashboard"
                        sclass="sidebar-button"
                        width="100%"
                        onClick="Executions.sendRedirect('/outward/checker/dashboard.zul')"/>

                    <button
                        label="Batches Queue"
                        sclass="sidebar-button"
                        width="100%"
                        onClick="Executions.sendRedirect('/outward/checker/batchesQueue.zul')"/>

                    <button
                        label="Reports"
                        sclass="sidebar-button active"
                        width="100%"
                        onClick="Executions.sendRedirect('/outward/checker/reports.zul')"/>

                    <button
                        label="Send to NPCI"
                        sclass="sidebar-button"
                        width="100%"
                        onClick="Executions.sendRedirect('/outward/checker/sendToNPCI.zul')"/>

                </div>

            </west>


            <!-- =====================================================
                 MAIN CONTENT
                 ===================================================== -->

            <center>

                <div sclass="checker-main">

                    <!-- HEADER -->

                    <div sclass="checker-header">

                        <label
                            value="Checker Reports"
                            sclass="page-title"/>

                    </div>


                    <!-- =================================================
                         INFORMATION
                         ================================================= -->

                    <div sclass="filter-card">

                        <label
                            value="Completed Checker Batches"
                            sclass="section-title"/>

                        <separator height="8px"/>

                        <label
                            value="Only batches with status CHECKER_COMPLETED are available for reporting."
                            sclass="filter-label"/>

                    </div>


                    <!-- =================================================
                         COMPLETED BATCHES
                         ================================================= -->

                    <div sclass="section-card">

                        <label
                            value="Checker Completed Batches"
                            sclass="section-title"/>

                        <separator height="15px"/>


                        <listbox
                            id="reportListbox"
                            width="100%"
                            mold="paging"
                            pageSize="10"
                            emptyMessage="No checker-completed batches found">

                            <listhead>

                                <listheader
                                    label="Batch ID"
                                    width="20%"/>

                                <listheader
                                    label="Total Cheques"
                                    width="15%"/>

                                <listheader
                                    label="Accepted"
                                    width="15%"/>

                                <listheader
                                    label="Rejected"
                                    width="15%"/>

                                <listheader
                                    label="Returned"
                                    width="15%"/>

                                <listheader
                                    label="Status"
                                    width="20%"/>

                            </listhead>

                        </listbox>

                    </div>

                </div>

            </center>

        </borderlayout>

    </window>

</zk>