<?xml version="1.0" encoding="UTF-8"?>

<?page title="Cheque Verification"?>

<zk>

<borderlayout
    width="100%"
    height="100%"
    apply="com.iispl.cts.controller.outward.checker.CheckerChequeVerificationController.java"
    style="background:#F4F7FB;">

        <!-- ============================================== -->
        <!-- HEADER -->
        <!-- ============================================== -->

        <north size="62px">

            <include src="/header.zul"/>

        </north>


        <!-- ============================================== -->
        <!-- SIDEBAR -->
        <!-- ============================================== -->

        <west size="280px">

            <include src="/checkersidebar.zul"/>

        </west>


        <!-- ============================================== -->
        <!-- MAIN CONTENT -->
        <!-- ============================================== -->

        <center>

            <vlayout
                width="100%"
                spacing="20px"
                style="padding:30px;">


                <!-- ====================================== -->
                <!-- PAGE TITLE -->
                <!-- ====================================== -->

                <hlayout width="100%"
                         valign="middle">

                    <vlayout>

                        <label
                            value="Cheque Verification"
                            style="
                                font-size:30px;
                                font-weight:bold;
                                color:#122B49;
                            "/>

                        <hlayout spacing="10px">

                            <label
                                value="Batch ID:"
                                style="
                                    font-size:14px;
                                    color:#667085;
                                "/>

                            <label
                                id="verificationBatchId"
                                value="-"
                                style="
                                    font-size:14px;
                                    font-weight:bold;
                                    color:#175CD3;
                                "/>

                        </hlayout>

                    </vlayout>


                    <space hflex="1"/>


                    <label
                        id="chequeSequence"
                        value="Cheque 0 of 0"
                        style="
                            font-size:16px;
                            font-weight:bold;
                            color:#475467;
                        "/>

                </hlayout>


                <!-- ====================================== -->
                <!-- MAIN CARD -->
                <!-- ====================================== -->

                <groupbox
                    width="100%"
                    style="
                        background:white;
                        border:1px solid #DCE5F0;
                        border-radius:8px;
                    ">


                    <vlayout
                        width="100%"
                        spacing="20px"
                        style="padding:25px;">


                        <!-- ================================== -->
                        <!-- IMAGE + DETAILS -->
                        <!-- ================================== -->

                        <hlayout
                            width="100%"
                            spacing="30px"
                            valign="top">


                            <!-- ============================== -->
                            <!-- LEFT SIDE -->
                            <!-- CHEQUE IMAGE -->
                            <!-- ============================== -->

                            <vlayout
                                hflex="1"
                                spacing="12px">


                                <label
                                    value="Scanned Cheque"
                                    style="
                                        font-size:20px;
                                        font-weight:bold;
                                        color:#122B49;
                                    "/>


                                <groupbox
                                    width="100%"
                                    style="
                                        background:#F8FAFC;
                                        border:1px solid #DCE5F0;
                                        border-radius:7px;
                                    ">


                                    <vlayout
                                        width="100%"
                                        align="center"
                                        style="padding:15px;">


                                        <!-- ACTUAL CHEQUE IMAGE -->

                                        <image
                                            id="chequeImage"
                                            width="100%"
                                            height="420px"
                                            style="
                                                object-fit:contain;
                                                background:white;
                                            "
                                        />

                                    </vlayout>

                                </groupbox>


                                <!-- ========================== -->
                                <!-- PREVIOUS / NEXT -->
                                <!-- ========================== -->

                                <hlayout
                                    width="100%"
                                    style="
                                        padding-top:10px;
                                    ">


                                    <button
                                        id="previousButton"
                                        label="← Previous"
                                        width="130px"
                                        style="
                                            background:white;
                                            color:#344054;
                                            border:1px solid #D0D5DD;
                                        "
                                    />


                                    <space hflex="1"/>


                                    <button
                                        id="nextButton"
                                        label="Next →"
                                        width="130px"
                                        style="
                                            background:#175CD3;
                                            color:white;
                                            border:none;
                                        "
                                    />

                                </hlayout>


                            </vlayout>


                            <!-- ============================== -->
                            <!-- RIGHT SIDE -->
                            <!-- CHEQUE DETAILS -->
                            <!-- ============================== -->

                            <vlayout
                                width="480px"
                                spacing="12px">


                                <label
                                    value="Cheque Details"
                                    style="
                                        font-size:20px;
                                        font-weight:bold;
                                        color:#122B49;
                                    "
                                />


                                <groupbox
                                    width="100%"
                                    style="
                                        background:white;
                                        border:1px solid #DCE5F0;
                                        border-radius:7px;
                                    ">


                                    <vlayout
                                        spacing="18px"
                                        style="padding:25px;">


                                        <!-- ================== -->
                                        <!-- CHEQUE NUMBER -->
                                        <!-- ================== -->

                                        <hlayout width="100%">

                                            <label
                                                value="Cheque Number"
                                                width="180px"
                                                style="
                                                    font-size:15px;
                                                    color:#667085;
                                                "
                                            />

                                            <label
                                                value=":"
                                                width="15px"
                                            />

                                            <label
                                                id="chequeNumberLabel"
                                                value="-"
                                                style="
                                                    font-size:15px;
                                                    font-weight:bold;
                                                "
                                            />

                                        </hlayout>


                                        <!-- ================== -->
                                        <!-- ACCOUNT NUMBER -->
                                        <!-- ================== -->

                                        <hlayout width="100%">

                                            <label
                                                value="Account Number"
                                                width="180px"
                                                style="
                                                    font-size:15px;
                                                    color:#667085;
                                                "
                                            />

                                            <label
                                                value=":"
                                                width="15px"
                                            />

                                            <label
                                                id="accountNumberLabel"
                                                value="-"
                                                style="
                                                    font-size:15px;
                                                    font-weight:bold;
                                                "
                                            />

                                        </hlayout>


                                        <!-- ================== -->
                                        <!-- DRAWER NAME -->
                                        <!-- ================== -->

                                        <hlayout width="100%">

                                            <label
                                                value="Drawer Name"
                                                width="180px"
                                                style="
                                                    font-size:15px;
                                                    color:#667085;
                                                "
                                            />

                                            <label
                                                value=":"
                                                width="15px"
                                            />

                                            <label
                                                id="drawerNameLabel"
                                                value="-"
                                                style="
                                                    font-size:15px;
                                                    font-weight:bold;
                                                "
                                            />

                                        </hlayout>


                                        <!-- ================== -->
                                        <!-- PAYEE NAME -->
                                        <!-- ================== -->

                                        <hlayout width="100%">

                                            <label
                                                value="Payee Name"
                                                width="180px"
                                                style="
                                                    font-size:15px;
                                                    color:#667085;
                                                "
                                            />

                                            <label
                                                value=":"
                                                width="15px"
                                            />

                                            <label
                                                id="payeeNameLabel"
                                                value="-"
                                                style="
                                                    font-size:15px;
                                                    font-weight:bold;
                                                "
                                            />

                                        </hlayout>


                                        <!-- ================== -->
                                        <!-- CHEQUE DATE -->
                                        <!-- ================== -->

                                        <hlayout width="100%">

                                            <label
                                                value="Cheque Date"
                                                width="180px"
                                                style="
                                                    font-size:15px;
                                                    color:#667085;
                                                "
                                            />

                                            <label
                                                value=":"
                                                width="15px"
                                            />

                                            <label
                                                id="chequeDateLabel"
                                                value="-"
                                                style="
                                                    font-size:15px;
                                                    font-weight:bold;
                                                "
                                            />

                                        </hlayout>


                                        <!-- ================== -->
                                        <!-- AMOUNT -->
                                        <!-- ================== -->

                                        <hlayout width="100%">

                                            <label
                                                value="Cheque Amount"
                                                width="180px"
                                                style="
                                                    font-size:15px;
                                                    color:#667085;
                                                "
                                            />

                                            <label
                                                value=":"
                                                width="15px"
                                            />

                                            <label
                                                id="amountLabel"
                                                value="-"
                                                style="
                                                    font-size:17px;
                                                    font-weight:bold;
                                                    color:#039855;
                                                "
                                            />

                                        </hlayout>


                                        <!-- ================== -->
                                        <!-- AMOUNT IN WORDS -->
                                        <!-- ================== -->

                                        <vlayout
                                            spacing="5px">

                                            <label
                                                value="Amount In Words"
                                                style="
                                                    font-size:15px;
                                                    color:#667085;
                                                "
                                            />

                                            <label
                                                id="amountInWordsLabel"
                                                value="-"
                                                style="
                                                    font-size:15px;
                                                    font-weight:bold;
                                                "
                                            />

                                        </vlayout>


                                        <!-- ================== -->
                                        <!-- MICR -->
                                        <!-- ================== -->

                                        <hlayout width="100%">

                                            <label
                                                value="MICR"
                                                width="180px"
                                                style="
                                                    font-size:15px;
                                                    color:#667085;
                                                "
                                            />

                                            <label
                                                value=":"
                                                width="15px"
                                            />

                                            <label
                                                id="micrLabel"
                                                value="-"
                                                style="
                                                    font-size:15px;
                                                    font-weight:bold;
                                                "
                                            />

                                        </hlayout>


                                        <!-- ================== -->
                                        <!-- STATUS -->
                                        <!-- ================== -->

                                        <hlayout width="100%">

                                            <label
                                                value="Status"
                                                width="180px"
                                                style="
                                                    font-size:15px;
                                                    color:#667085;
                                                "
                                            />

                                            <label
                                                value=":"
                                                width="15px"
                                            />

                                            <label
                                                id="statusLabel"
                                                value="PENDING"
                                                style="
                                                    font-size:15px;
                                                    font-weight:bold;
                                                    color:#D97706;
                                                "
                                            />

                                        </hlayout>


                                    </vlayout>

                                </groupbox>

                            </vlayout>


                        </hlayout>


                        <separator/>


                        <!-- ================================== -->
                        <!-- BOTTOM ACTION -->
                        <!-- ================================== -->

                        <hlayout
                            width="100%"
                            valign="middle">


                          <button
    id="backButton"
    label="← Back to Queue"
    width="160px"
    style="
        background:white;
        color:#475467;
        border:1px solid #D0D5DD;
    "
/>


                            <space hflex="1"/>


                            <button
                                label="⊗ Reject"
                                width="130px"
                                style="
                                    background:white;
                                    color:#D92D20;
                                    border:1px solid #D92D20;
                                "
                            />


                            <button
                                label="★ Send to Maker"
                                width="160px"
                                style="
                                    background:white;
                                    color:#D97706;
                                    border:1px solid #F59E0B;
                                "
                            />


                            <button
                                label="✓ Approve"
                                width="150px"
                                style="
                                    background:#12B76A;
                                    color:white;
                                    border:none;
                                "
                            />


                        </hlayout>


                    </vlayout>


                </groupbox>


            </vlayout>


        </center>


    </borderlayout>

</zk>