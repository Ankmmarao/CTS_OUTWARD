<?xml version="1.0" encoding="UTF-8"?>

<?page title="Send to NPCI"?>

<zk>

    <borderlayout width="100%"
                  height="100%"
                  style="background:#F4F7FB;">

        <!-- HEADER -->

        <north size="62px">
            <include src="/header.zul"/>
        </north>


        <!-- SIDEBAR -->

        <west size="280px">
            <include src="/checkersidebar.zul"/>
        </west>


        <!-- CONTENT -->

        <center>

            <vlayout spacing="20px"
                     style="padding:30px;">

                <!-- TITLE -->

                <label value="Send to NPCI"
                       style="font-size:30px;
                              font-weight:bold;
                              color:#122B49;"/>


                <!-- INFORMATION -->

                <groupbox width="100%"
                          style="background:white;
                                 border:1px solid #DCE5F0;
                                 border-radius:8px;">

                    <vlayout spacing="6px"
                             style="padding:20px;">

                        <label value="Batches Ready for NPCI"
                               style="font-size:19px;
                                      font-weight:bold;
                                      color:#122B49;"/>

                        <label value="Only fully verified batches can be submitted to NPCI."
                               style="font-size:14px;
                                      color:#667085;"/>

                    </vlayout>

                </groupbox>


                <!-- BATCH TABLE -->

                <groupbox width="100%"
                          style="background:white;
                                 border:1px solid #DCE5F0;
                                 border-radius:8px;">

                    <listbox width="100%"
                             emptyMessage="No batches are ready for NPCI submission.">

                        <listhead>

                            <listheader label="Batch ID"
                                        width="15%"/>

                            <listheader label="Total Cheques"
                                        width="15%"/>

                            <listheader label="Verified Cheques"
                                        width="18%"/>

                            <listheader label="Batch Status"
                                        width="22%"/>

                            <listheader label="Verified By"
                                        width="18%"/>

                            <listheader label="Action"
                                        width="12%"/>

                        </listhead>


                        <!-- READY BATCH -->

                        <listitem>

                            <listcell label="B002"/>

                            <listcell label="12"/>

                            <listcell label="12"/>


                            <listcell>

                                <label value="Ready for NPCI"
                                       style="background:#D1FADF;
                                              color:#039855;
                                              padding:7px 12px;
                                              border-radius:5px;
                                              font-weight:bold;"/>

                            </listcell>


                            <listcell label="checker789"/>


                            <listcell>

                                <button label="Send"
                                        width="90px"
                                        style="background:#2457D6;
                                               color:white;
                                               border:none;"/>

                            </listcell>

                        </listitem>


                        <!-- SECOND BATCH -->

                        <listitem>

                            <listcell label="B003"/>

                            <listcell label="8"/>

                            <listcell label="8"/>


                            <listcell>

                                <label value="Ready for NPCI"
                                       style="background:#D1FADF;
                                              color:#039855;
                                              padding:7px 12px;
                                              border-radius:5px;
                                              font-weight:bold;"/>

                            </listcell>


                            <listcell label="checker789"/>


                            <listcell>

                                <button label="Send"
                                        width="90px"
                                        style="background:#2457D6;
                                               color:white;
                                               border:none;"/>

                            </listcell>

                        </listitem>

                    </listbox>

                </groupbox>

            </vlayout>

        </center>

    </borderlayout>

</zk>