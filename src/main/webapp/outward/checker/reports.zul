<?xml version="1.0" encoding="UTF-8"?>

<?page title="Checker Reports"
        contentType="text/html;charset=UTF-8"?>

<?style src="/css/checker.css"?>

<zk>

```
<borderlayout
    width="100%"
    height="100%"
    apply="com.iispl.cts.controller.outward.checker.CheckerReportsController">

    <!-- ================= HEADER ================= -->

    <north
        size="70px"
        border="0">

        <include
            src="/header.zul"
            width="100%"
            height="100%" />

    </north>


    <!-- ================= SIDEBAR ================= -->

    <west
        size="230px"
        border="0">

        <include
            src="/checkersidebar.zul"
            width="100%"
            height="100%" />

    </west>


    <!-- ================= MAIN CONTENT ================= -->

    <center
        border="0"
        autoscroll="true">

        <div
            width="100%"
            style="padding:35px 55px;">

            <!-- PAGE TITLE -->

            <label
                value="Checker Reports"
                style="
                    font-size:32px;
                    font-weight:bold;
                    display:block;
                    margin-bottom:30px;" />


            <!-- ================= INFORMATION ================= -->

            <div
                sclass="filter-card">

                <label
                    value="Assigned Batches"
                    sclass="section-title" />

                <separator height="8px" />

                <label
                    value="Only batches with status ASSIGNED are available for reporting."
                    sclass="filter-label" />

            </div>


            <!-- ================= ASSIGNED BATCHES ================= -->

            <div
                sclass="section-card">

                <label
                    value="Assigned Batches"
                    sclass="section-title" />

                <separator height="15px" />

                <listbox
                    id="reportListbox"
                    width="100%"
                    mold="paging"
                    pageSize="10"
                    emptyMessage="No assigned batches found">

                    <listhead>

                        <listheader
                            label="Batch ID"
                            width="18%" />

                        <listheader
                            label="Total Cheques"
                            width="13%" />

                        <listheader
                            label="Accepted"
                            width="11%" />

                        <listheader
                            label="Rejected"
                            width="11%" />

                        <listheader
                            label="Returned"
                            width="11%" />

                        <listheader
                            label="Status"
                            width="14%" />

                        <listheader
                            label="Action"
                            width="22%" />

                    </listhead>

                </listbox>

            </div>

        </div>

    </center>

</borderlayout>
```

</zk>
