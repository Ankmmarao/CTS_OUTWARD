<?xml version="1.0" encoding="UTF-8"?>

<zk>

    <hlayout width="100%"
             height="62px"
             valign="middle"
             apply="com.iispl.cts.controller.outward.HeaderController"
             style="background:#081B33;
                    padding:0 18px;
                    box-sizing:border-box;
                    align-items:center;">

        <!-- Menu -->
        <button label="☰"
                width="42px"
                height="40px"
                style="background:#075BC8;
                       color:white;
                       border:none;
                       font-size:20px;"/>

        <!-- Application Title -->
        <label value="CTS INVOICE MAKER / DASHBOARD"
               style="color:white;
                      font-size:22px;
                      font-weight:bold;
                      margin-left:12px;"/>

        <space hflex="1"/>

        <!-- Current Date -->
        <label id="dateLabel"
               value="▣  Date :"
               style="color:#B8C9E2;
                      font-size:15px;
                      margin-right:25px;"/>

        <!-- Last Login -->
        <label id="lastLoginLabel"
               value="◷  Last Login :"
               style="color:#B8C9E2;
                      font-size:15px;
                      margin-right:25px;"/>

        <!-- Username -->
        <label id="usernameLabel"
               value="♙  User"
               style="color:white;
                      font-size:15px;
                      font-weight:bold;
                      margin-right:20px;"/>

        <!-- Logout -->
        <button id="logoutButton"
                label="Logout"
                width="80px"
                height="36px"
                style="background:#C62828;
                       color:white;
                       border:none;
                       font-weight:bold;
                       cursor:pointer;"/>

    </hlayout>

</zk>